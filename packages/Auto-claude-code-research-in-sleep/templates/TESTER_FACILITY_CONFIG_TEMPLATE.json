{
  "schema_version": 1,
  "mode": "tester_facility",
  "tester_id": "benchmark-test",
  "project_id": "research-project",
  "version": "v1",
  "benchmark": {
    "name": "YOUR_BENCHMARK",
    "source": "YOUR_PINNED_BENCHMARK_SOURCE",
    "revision": "PINNED_COMMIT"
  },
  "dataset": {
    "name": "YOUR_DATASET",
    "revision": "PINNED_DATA_REVISION",
    "split": "test",
    "expected_samples": 1000
  },
  "metrics": [
    {
      "name": "accuracy",
      "direction": "higher_better",
      "aggregation": "mean"
    }
  ],
  "execution": {
    "cwd": "/absolute/path/to/evaluation",
    "env": {}
  },
  "setup": [
    {
      "argv": ["python", "evaluate.py", "setup"],
      "timeout_ms": 3600000
    }
  ],
  "healthcheck": {
    "argv": ["python", "evaluate.py", "check"],
    "timeout_ms": 60000
  },
  "smoke": {
    "argv": ["python", "evaluate.py", "run"],
    "timeout_ms": 300000
  },
  "test": {
    "argv": ["python", "evaluate.py", "run"],
    "timeout_ms": 86400000
  },
  "evidence_files": ["evaluate.py", "evaluation-config.json", "data-manifest.json"]
}
