{
  "name": "@getpaseo/aris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:clean",
    "build:clean": "npm run clean && tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean-package-dist.mjs && node -e \"require('node:fs').rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx tests/test_a0.ts && npx tsx tests/test_tester_facility.ts && npx tsx tests/test_setup.ts && npx tsx tests/test_validation.ts",
    "test:python": "python3 -m unittest discover -s tests -p \"test_*.py\""
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
