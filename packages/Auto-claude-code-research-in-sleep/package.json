{
  "name": "@getpaseo/aris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:clean",
    "build:clean": "npm run clean && tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean-package-dist.mjs && node -e \"require('node:fs').rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && ARIS_TEST_DIST=1 npx tsx tests/test_run_state.ts",
    "test:source": "npx tsx tests/test_run_state.ts"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
