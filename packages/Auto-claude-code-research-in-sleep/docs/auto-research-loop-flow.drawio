        <mxCell id="p0-source" value="源码依据：skills/auto-research-loop/SKILL.md §Startup、Fresh start vs Resume；src/tools/metric-gate.ts；src/tools/run-state.ts。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p0-1">
