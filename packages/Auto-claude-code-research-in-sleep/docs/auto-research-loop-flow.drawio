  <diagram id="phase4" name="05 Phase 4 受约束 Idea Discovery">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="p4-0" />
        <mxCell id="p4-1" parent="p4-0" />
        <mxCell id="p4-start" value="&lt;b&gt;Phase 4 开始&lt;/b&gt;&lt;br&gt;由 Phase 3 的 stop_reason=null 进入；iteration 已先加一，source_iteration=iteration−1。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p4-1">
          <mxGeometry x="810" y="20" width="780" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p4-input" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;ROOT/research-wiki/gap_map.md；上一轮 workers/&lt;source_iteration&gt;-auto-review-loop/outputs/final-analysis/EXPERIMENT_RESULTS.md；final-inputs/EXPERIMENT_TRACKER.md；final-inputs/EXPERIMENT_RESULTS.md；AUTO_REVIEW.md。&lt;br&gt;context：metric_gap_constrained=true、source_iteration、metric_name/target/direction/tolerance/current/history、prior open_gap_ids。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="145" width="1220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p4-manifest" value="&lt;b&gt;写并派发 /idea-discovery&lt;/b&gt;&lt;br&gt;文件：workers/&lt;iteration&gt;-idea-discovery/input-manifest.json；inputs 只能引用上面五类证据；context.source_iteration 必须等于 iteration−1；output_dir=outputs。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="350" width="1220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-branch" value="&lt;b&gt;idea-discovery 的 metric-gap constrained branch&lt;/b&gt;&lt;br&gt;发现 3–5 个 implementation-ready candidate；优先引用已有 gap id，但新问题只能写 provisional 描述 + evidence path，不创建权威 id。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="515" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p4-fields" value="&lt;b&gt;每个 candidate 必须具备的字段&lt;/b&gt;&lt;br&gt;target gap ids/description；evidence paths；mechanism；exact code/config change；command；dataset/split；seeds；metric；closing threshold；expected artifact；runtime estimate；main risk。缺字段就拒绝候选，gap-planner 不得补写。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="670" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-forbid" value="&lt;b&gt;明确禁止&lt;/b&gt;&lt;br&gt;不调用 /research-lit、/idea-creator、/novelty-check、/research-review、/research-refine-pipeline；不做 web/literature search、pilot、开放 pipeline、user checkpoint、method refinement、独立 experiment plan、rendering。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="515" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-review" value="&lt;b&gt;一次 fresh method audit&lt;/b&gt;&lt;br&gt;读取 run 的 .paseo-config.json，调用配置的 reviewer provider/mode/thinking；只审 supplied artifacts、证据适配、可行性、因果隔离、测量质量、阈值可测试性；prompt 禁止 web/literature/novelty。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="850" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-review-d" value="method reviewer pass / warn？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p4-1">
          <mxGeometry x="900" y="1030" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-fix" value="&lt;b&gt;一次有界修正&lt;/b&gt;&lt;br&gt;只按 reviewer 明确指出的问题修正 candidates；用 fresh reviewer 再审一次。第二次仍 fail → 写 failed receipt，不继续。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="1015" width="500" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p4-select" value="&lt;b&gt;排序并只选一个&lt;/b&gt;&lt;br&gt;pass/warn 后写排名、exactly one selected_idea_id；不提问用户、不跑 pilot、不写 EXPERIMENT_PLAN/FINAL_PROPOSAL；写完 receipt 后立即返回。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="1210" width="1220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-report" value="&lt;b&gt;输出：IDEA_REPORT.md&lt;/b&gt;&lt;br&gt;outputs/IDEA_REPORT.md；包含 candidates、每个候选必需字段、method review、排序、selected_idea_id。&lt;br&gt;不是完整 idea-stage pipeline：本分支不产生 FINAL_PROPOSAL.md、EXPERIMENT_PLAN.md、HTML。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="1370" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p4-receipt" value="&lt;b&gt;receipt.dashboard_patch&lt;/b&gt;&lt;br&gt;best_idea：id/title/metric/iteration；idea_ids：候选 id 数组；summary.mode=metric-gap-constrained；method_review.verdict=pass|warn、review_agent_id、reviewer_provider；status=done。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="1545" width="1220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-merge" value="&lt;b&gt;主 orchestrator&lt;/b&gt;&lt;br&gt;dashboard-merge 原子写 best_idea、idea_ids、applied_receipts；current_phase 改为 gap-planner；不读取 IDEA_REPORT.md 内容。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="1710" width="1220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-end" value="&lt;b&gt;进入 Phase 4.5&lt;/b&gt;&lt;br&gt;selected_idea_id 由 dashboard.best_idea.id 传给 gap-planner" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p4-1">
          <mxGeometry x="850" y="1850" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p4-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-start" target="p4-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-input" target="p4-manifest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-manifest" target="p4-branch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-branch" target="p4-fields">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-fields" target="p4-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-review" target="p4-review-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e7" value="否，第一次" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p4-1" source="p4-review-d" target="p4-fix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e8" value="修正后 fresh re-audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p4-1" source="p4-fix" target="p4-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p4-1" source="p4-review-d" target="p4-select">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-select" target="p4-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-report" target="p4-receipt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-receipt" target="p4-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p4-1" source="p4-merge" target="p4-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-source" value="源码依据：skills/auto-research-loop/SKILL.md §Phase 4；skills/idea-discovery/SKILL.md §Metric-gap constrained branch。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="1850" width="700" height="50" as="geometry" />
        </mxCell>
      </root>
