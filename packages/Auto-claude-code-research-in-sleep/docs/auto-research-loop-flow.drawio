<mxfile host="Electron" pages="12">
  <diagram id="overview" name="00 总流程">
    <mxGraphModel dx="2885" dy="1124" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="ov-0" />
        <mxCell id="ov-1" parent="ov-0" />
        <mxCell id="ov-start" parent="ov-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="&lt;b&gt;开始 / 恢复&lt;/b&gt;&lt;br&gt;参数：run_id、auto_write、render_html、max_iterations" vertex="1">
          <mxGeometry height="70" width="520" x="760" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ov-p0" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;Startup：前置条件与初始化&lt;/b&gt;&lt;br&gt;读取 CLAUDE.md 的 active Metric Target；baseline 此时是 /research-setup 从 prior work 抄来的期望锚点，尚未实测。确认实验环境 env.json.status=complete、scripts/ 存在；创建 dashboard.json 与 run-state.json，current_phase=idea-discovery。" vertex="1">
          <mxGeometry height="110" width="800" x="620" y="130" as="geometry" />
        </mxCell>
        <mxCell id="ov-s1" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;Stage 1：Idea Discovery（完整管线）&lt;/b&gt;&lt;br&gt;和 /research-pipeline Stage 1 同一契约，没有受约束分支：读 RESEARCH_BRIEF.md 与 research-wiki 的 query_pack（Open Problems 段即搜索种子），产出 IDEA_REPORT.md + EXPERIMENT_PLAN.md。iteration 1 按 brief 的 Baseline Reproduction 节把 baseline 当作首个候选，不是特例流程。idea 页由 /idea-creator Phase 7 的 upsert_idea 出生。" vertex="1">
          <mxGeometry height="130" width="800" x="620" y="290" as="geometry" />
        </mxCell>
        <mxCell id="ov-s2" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;Stage 2：Experiment Bridge&lt;/b&gt;&lt;br&gt;同时收 Stage 1 的 EXPERIMENT_PLAN.md（目标与测量方式）和 IDEA_REPORT.md（要实现的方法）；先 sanity、再部署并收集结果；内部强制调用 /analyze-results；receipt 发布 metric.current 等字段。" vertex="1">
          <mxGeometry height="110" width="800" x="620" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ov-s3" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;Stage 3：Auto Review Loop&lt;/b&gt;&lt;br&gt;外部 reviewer 评分 → 代码/实验/分析修复 → 重新审查；结束时强制最终 /analyze-results，发布质量 verdict 和最终 metric。&lt;br&gt;终止步骤 6 派发 /result-to-claim：实验节点、verdict、edges、idea outcome、problem 开关、query_pack 重建全在那里发生。" vertex="1">
          <mxGeometry height="130" width="800" x="620" y="630" as="geometry" />
        </mxCell>
        <mxCell id="ov-anchor" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" value="&lt;b&gt;仅 iteration 1：锚定 baseline&lt;/b&gt;&lt;br&gt;把 dashboard.metric.baseline 从 prior-work 期望值刷成 iteration 1 的实测值（纯 dashboard 字段算术）。此后 metric-gate 的 patience 以实测 baseline 为 incumbent，iteration 1 自身不计入 streak。" vertex="1">
          <mxGeometry height="95" width="800" x="620" y="810" as="geometry" />
        </mxCell>
        <mxCell id="ov-gate" parent="ov-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=5;" value="&lt;b&gt;Gate：metric-gate.js evaluate&lt;/b&gt;&lt;br&gt;dashboard 字段 → invalid / target / budget / patience&lt;br&gt;写 stop_reason" vertex="1">
          <mxGeometry height="150" width="540" x="750" y="955" as="geometry" />
        </mxCell>
        <mxCell id="ov-stop" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" value="&lt;b&gt;停止&lt;/b&gt;&lt;br&gt;metric_met / budget_exhausted / patience_exhausted&lt;br&gt;dashboard.status=finishing；loop done；进入 Summary" vertex="1">
          <mxGeometry height="100" width="500" x="1500" y="980" as="geometry" />
        </mxCell>
        <mxCell id="ov-invalid" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" value="&lt;b&gt;无效指标&lt;/b&gt;&lt;br&gt;invalid_metric：loop failed；summary/paper-writing skipped；dashboard.status=invalid；退出" vertex="1">
          <mxGeometry height="100" width="500" x="30" y="980" as="geometry" />
        </mxCell>
        <mxCell id="ov-p5" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" value="&lt;b&gt;Summary（停止后）&lt;/b&gt;&lt;br&gt;summary 子 agent 读取 dashboard + wiki + 最后一轮分析/审查，生成 NARRATIVE_REPORT.md；可选调用 /render-html。" vertex="1">
          <mxGeometry height="100" width="500" x="1500" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="ov-p6" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;" value="&lt;b&gt;Paper Writing（可选）&lt;/b&gt;&lt;br&gt;达标且 iteration≥2；AUTO_WRITE=true；$AUDIT_VERIFIER 判 paper audit pass 后完成。" vertex="1">
          <mxGeometry height="110" width="500" x="2060" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="ov-end" parent="ov-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;dashboard.status=completed；run-state 四个外层 phase terminal" vertex="1">
          <mxGeometry height="70" width="500" x="1500" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="ov-e1" edge="1" parent="ov-1" source="ov-start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-p0" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e2" edge="1" parent="ov-1" source="ov-p0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-s1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e3" edge="1" parent="ov-1" source="ov-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" target="ov-s2" value="plan_path + idea_report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e4" edge="1" parent="ov-1" source="ov-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-s3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e5" edge="1" parent="ov-1" source="ov-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-anchor" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e6" edge="1" parent="ov-1" source="ov-anchor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-gate" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e7" edge="1" parent="ov-1" source="ov-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" target="ov-stop" value="非 invalid_metric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e8" edge="1" parent="ov-1" source="ov-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" target="ov-invalid" value="invalid_metric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e9" edge="1" parent="ov-1" source="ov-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="ov-s1" value="stop_reason 为空 → iteration+1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="1030" />
              <mxPoint x="570" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ov-e10" edge="1" parent="ov-1" source="ov-stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-p5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e11" edge="1" parent="ov-1" source="ov-p5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" target="ov-p6" value="gate pass + auto_write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e12" edge="1" parent="ov-1" source="ov-p5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-end" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e13" edge="1" parent="ov-1" source="ov-p6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" target="ov-end" value="审计通过">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-note" parent="ov-1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" value="&lt;b&gt;核心边界&lt;/b&gt;&lt;br&gt;主 orchestrator 只读 dashboard.json 与 receipt.json；worker 的 Markdown、结果和日志通过 input-manifest → receipt.dashboard_patch 传递。Gate 不读取 review verdict；review 的 ready/almost/not ready 只结束本轮审查。" vertex="1">
          <mxGeometry height="160" width="500" x="30" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="ov-wiki" parent="ov-1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" value="&lt;b&gt;wiki 写侧：orchestrator 一个字都不写&lt;/b&gt;&lt;br&gt;idea 页 → /idea-creator Phase 7 的 upsert_idea；实验节点 + verdict + supports/invalidates 边 + idea outcome + query_pack 重建 → /result-to-claim Step 5；claim 节点 → /proof-checker 的 add_claim；problem 实体 → add_problem，写者只有三个：/research-setup（根问题）、/result-to-claim（partial/no 判定的子问题）、/kill-argument（未答攻击的子问题）。每个实体恰好一个出生点，第二个写者就是竞态。" vertex="1">
          <mxGeometry height="200" width="920" x="620" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="ov-source" parent="ov-1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="源码依据：skills/auto-research-loop/SKILL.md（薄循环 = research-pipeline Stage 1-3 + metric gate）；skills/research-pipeline/SKILL.md §Stage 1-3；src/tools/metric-gate.ts。相关子图见后续页面。" vertex="1">
          <mxGeometry height="40" width="1900" x="30" y="1420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase0" name="01 Startup 初始化与恢复">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="p0-start" value="&lt;b&gt;进入 Startup&lt;/b&gt;&lt;br&gt;fresh 或 --resume &lt;run_id&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p0-1">
          <mxGeometry x="930" y="20" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p0-read" value="&lt;b&gt;解析项目和运行配置&lt;/b&gt;&lt;br&gt;动作：定位 ROOT；解析 project slug；解析 --max-iterations、--auto-write、--render-html；用 tools/render_w_agent_prompt.sh --emit-config 生成一次 Paseo 配置。&lt;br&gt;落盘：.aris/runs/&lt;run_id&gt;.paseo-config.json，字段 executor_provider、executor_mode、executor_thinking、notify_on_finish。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="130" width="1080" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-metric" value="&lt;b&gt;读取并验证 Metric Target&lt;/b&gt;&lt;br&gt;子程序：metric-gate.js config ROOT。&lt;br&gt;输入：CLAUDE.md 中未被 HTML 注释的 ## Metric Target；字段 primary: 数值 + 单位、direction、tolerance、baseline。&lt;br&gt;输出：target、name、direction、tolerance、baseline。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="300" width="1080" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-md" value="Metric Target 可用且字段合法？&lt;br&gt;primary 是有限数；direction ∈ higher_better/lower_better；tolerance ∈ [0,1)。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="850" y="470" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p0-metric-fail" value="&lt;b&gt;失败&lt;/b&gt;&lt;br&gt;没有 active Metric Target 或字段非法；不创建可运行 loop。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="495" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-env" value="&lt;b&gt;检查生成的实验环境&lt;/b&gt;&lt;br&gt;输入：.claude/skills/run-&lt;project&gt;-experiment/env.json 与 scripts/。判断字段：env.json.status == complete 且 scripts/ 目录存在。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="660" width="1080" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-d" value="环境已完成？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p0-1">
          <mxGeometry x="900" y="815" width="580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-call" value="&lt;b&gt;子 skill：/experiment-env-manager&lt;/b&gt;&lt;br&gt;动作：以 mode=setup、run-id、paseo-config 调用；等待完成通知；读取 .aris/runs/&lt;run_id&gt;.experiment-env-manager.&lt;project&gt;.done.json；归档子 agent。&lt;br&gt;它负责生成 env.json/scripts 并完成环境审计。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="1780" y="790" width="570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-ok" value="env.json.status=complete 且 scripts/ 存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="1780" y="1010" width="570" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-fail" value="&lt;b&gt;失败&lt;/b&gt;&lt;br&gt;环境管理器完成但 bundle 仍无效；停止初始化。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="1780" y="1190" width="570" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-plan" value="&lt;b&gt;校验 baseline 已锚定&lt;/b&gt;&lt;br&gt;读取 CLAUDE.md ## Metric Target 的 baseline 值（由 /research-setup Phase 7.6 复现并写入）。&lt;br&gt;为空则报错退出：先运行 /research-setup 完成 baseline 复现。循环内不再复现 baseline。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1000" width="1080" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p0-plan-d" value="Metric Target baseline 值非空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p0-1">
          <mxGeometry x="850" y="1165" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p0-plan-fail" value="&lt;b&gt;失败&lt;/b&gt;&lt;br&gt;没有基线实验计划，不能进入迭代。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="1190" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-freshresume" value="&lt;b&gt;fresh / resume 分支&lt;/b&gt;&lt;br&gt;fresh：生成 run_id，创建 workers/，初始化 dashboard 和 run-state。&lt;br&gt;resume：读取 .aris/runs/&lt;run_id&gt;.json + dashboard.json；按 outer phase 与 current_phase 决定重跑、继续或跳过。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1360" width="1080" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p0-dashboard" value="&lt;b&gt;fresh 的初始化写入&lt;/b&gt;&lt;br&gt;.aris/runs/&lt;run_id&gt;/dashboard.json：run_id、project、status=running、iteration=1、max_iterations、current_phase=init（loop 启动后置为 idea-discovery）；config.auto_write/render_html/patience；metric.name/target/direction/tolerance/baseline（setup 从 prior work 抄的期望锚点，iteration 1 后由 loop 刷成实测值）/current=null/history=[]；best_idea=null；gaps.open/closed/total；last_review.verdict/score/reviewer_id；stop_reason=null；system_errors.total/last；applied_receipts=[]。&lt;br&gt;.aris/runs/&lt;run_id&gt;.json：phases=[init,loop,summary,paper-writing]，每项 status/artifact/verdict_id/reviewer/updated。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1550" width="1080" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p0-done" value="&lt;b&gt;初始化完成&lt;/b&gt;&lt;br&gt;run-state：init done → accept，verdict_id/reviewer=deterministic:preconditions；loop=running。&lt;br&gt;dashboard.current_phase=idea-discovery；进入 Stage 1。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1750" width="1080" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p0-s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-start" target="p0-read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-read" target="p0-metric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-metric" target="p0-md">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-md" target="p0-metric-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-md" target="p0-env">
          <mxGeometry relative="1" as="geometry" />
