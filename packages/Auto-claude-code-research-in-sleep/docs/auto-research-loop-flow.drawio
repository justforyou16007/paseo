  <diagram id="phase3" name="05 Gate Metric Evaluation">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />
        <mxCell id="p3-start" value="&lt;b&gt;Gate 开始&lt;/b&gt;&lt;br&gt;Stage 1/2/3 receipt 已合并；iteration 1 的 baseline 锚定已完成；dashboard 是唯一输入。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p3-1">
          <mxGeometry x="850" y="20" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p3-input" value="&lt;b&gt;读取字段&lt;/b&gt;&lt;br&gt;.aris/runs/&lt;run_id&gt;/dashboard.json：metric.current、metric.target、metric.direction、metric.tolerance、metric.history；iteration、max_iterations；config.patience。&lt;br&gt;禁止：读取 worker Markdown、raw results、receipt 原文、last_review 做停止判断；禁止 dispatch/reviewer。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="145" width="1140" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-calc" value="&lt;b&gt;metric-gate.js evaluate&lt;/b&gt;&lt;br&gt;计算：band = abs(target) × tolerance；higher_better threshold = target − band；lower_better threshold = target + band。&lt;br&gt;patience：incumbent 在 metric.baseline 为有限数时用它做种子，此时 iteration 1（产生 baseline 的那一轮复现）不计入 streak；按 history.iter 排序，只有比此前 best 更好才清零，否则 streak+1；每次从 history 重算，不累积计数。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="330" width="1140" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-invalid" value="判断 1：current 非有限/为空，或 target、direction、tolerance、history、iteration、max_iterations、patience 非法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="525" width="920" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p3-invalid" value="&lt;b&gt;invalid_metric&lt;/b&gt;&lt;br&gt;metric-gate 原子写 dashboard.stop_reason=invalid_metric；dashboard.status=invalid；run-state：loop failed、summary skipped、paper-writing skipped；不生成 summary/paper。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="535" width="560" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-target" value="判断 2：目标达成？&lt;br&gt;higher_better：current ≥ target − abs(target)×tolerance；lower_better：current ≤ target + abs(target)×tolerance。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="735" width="920" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p3-target" value="stop_reason=metric_met&lt;br&gt;dashboard.status=finishing；run-state loop done；进入 Summary。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="1780" y="750" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-budget" value="判断 3：iteration ≥ max_iterations？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="945" width="920" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-budget" value="stop_reason=budget_exhausted&lt;br&gt;只说明预算耗尽，不说明质量；dashboard.status=finishing；loop done；进入 Summary。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="1780" y="960" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-patience" value="判断 4：trailing no-progress streak ≥ config.patience？默认 patience=2。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="1135" width="920" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-patience" value="stop_reason=patience_exhausted&lt;br&gt;只说明连续没有指标改善（以锚定后的 baseline 为 incumbent）；dashboard.status=finishing；loop done；进入 Summary。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="1780" y="1150" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-continue" value="&lt;b&gt;没有任何停止原因&lt;/b&gt;&lt;br&gt;stop_reason 仍为 null；dashboard.status 继续 running。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="1340" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-inc" value="&lt;b&gt;进入下一 iteration&lt;/b&gt;&lt;br&gt;dashboard.iteration 只增加一次；current_phase=idea-discovery；source_iteration=旧 iteration。resume 若已在 idea-discovery，只从 iteration−1 推导 source_iteration，不能再次加一。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="1480" width="1140" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-end" value="&lt;b&gt;iteration+1，回到 Stage 1&lt;/b&gt;&lt;br&gt;Idea Discovery 读上一轮证据与 query_pack 的 Open Problems。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p3-1">
          <mxGeometry x="870" y="1645" width="660" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-start" target="p3-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-input" target="p3-calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-calc" target="p3-d-invalid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-invalid" target="p3-invalid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-invalid" target="p3-d-target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-target" target="p3-target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-target" target="p3-d-budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e8" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-budget" target="p3-budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-budget" target="p3-d-patience">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-patience" target="p3-patience">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e11" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-patience" target="p3-continue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-continue" target="p3-inc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-inc" target="p3-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-source" value="源码依据：skills/auto-research-loop/SKILL.md §Gate: Metric Evaluation、Stop Gate；src/tools/metric-gate.ts evaluate。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="1645" width="700" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase5" name="06 Summary">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="p5-0" />
        <mxCell id="p5-1" parent="p5-0" />
        <mxCell id="p5-start" value="&lt;b&gt;Summary 触发&lt;/b&gt;&lt;br&gt;dashboard.status=finishing；stop_reason 已由 metric-gate 确定。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="850" y="20" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p5-invalid" value="&lt;b&gt;例外：invalid_metric&lt;/b&gt;&lt;br&gt;Summary 被跳过；run-state loop=failed、summary=skipped、paper-writing=skipped；dashboard.status=invalid。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="150" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p5-input" value="&lt;b&gt;summary worker 输入&lt;/b&gt;&lt;br&gt;dashboard.json；research-wiki/index.md；research-wiki/query_pack.md（Open Problems 段）；最后一轮 final-analysis/EXPERIMENT_RESULTS.md；最后一轮 AUTO_REVIEW.md。&lt;br&gt;context.stop_reason、total_iterations、final_metric、target_metric、metric_history。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="150" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p5-dispatch" value="&lt;b&gt;summary 子 agent&lt;/b&gt;&lt;br&gt;不是 /render-html；它负责从结构化输入生成新内容。调用 create_agent，要求只写 output_dir 指定路径。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="340" width="1220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5-report" value="&lt;b&gt;输出：NARRATIVE_REPORT.md&lt;/b&gt;&lt;br&gt;文件：workers/summary/outputs/NARRATIVE_REPORT.md。必须包含 metric_trajectory、stop_reason、iteration_log、仍 open 的 problem、已 solved 的 problem、artifacts。receipt.primary_output=NARRATIVE_REPORT.md；dashboard_patch.summary_path=run-relative 路径。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="485" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p5-html-d" value="config.render_html=true？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="930" y="665" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-html" value="&lt;b&gt;可选子 skill：/render-html&lt;/b&gt;&lt;br&gt;输入：NARRATIVE_REPORT.md；选择 academic 模板，临时 HTML 仅结构转换；写 NARRATIVE_REPORT.html / receipt.html_rendered=true。失败记录但不阻断 summary。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="1960" y="635" width="590" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p5-accept" value="&lt;b&gt;run-state 写入&lt;/b&gt;&lt;br&gt;loop 用 deterministic:&lt;stop_reason&gt; accept，不能用 reviewer id；summary done → accept，verdict=deterministic:summary；artifact 指向 NARRATIVE_REPORT.md。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="850" width="1220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p5-end" value="&lt;b&gt;进入 Paper Writing&lt;/b&gt;&lt;br&gt;由 dashboard.metric、iteration、config.auto_write 决定是否写论文" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="850" y="1020" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p5-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-start" target="p5-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-input" target="p5-dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-dispatch" target="p5-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-report" target="p5-html-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p5-1" source="p5-html-d" target="p5-html">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e6" value="否 / 失败也继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p5-1" source="p5-html-d" target="p5-accept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-html" target="p5-accept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-accept" target="p5-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-source" value="源码依据：skills/auto-research-loop/SKILL.md §Summary (on stop)；skills/render-html/SKILL.md §Manifest/Workflow。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="1020" width="700" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase6" name="07 Paper Writing（可选）">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="p6-0" />
        <mxCell id="p6-1" parent="p6-0" />
        <mxCell id="p6-start" value="&lt;b&gt;Paper Writing gate&lt;/b&gt;&lt;br&gt;输入：dashboard.metric.current、target、direction、tolerance、iteration、config.auto_write。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p6-1">
          <mxGeometry x="850" y="20" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-gate" value="metric 达标 AND iteration ≥ 2？&lt;br&gt;higher_better：current ≥ target − abs(target)×tolerance；lower_better：current ≤ target + abs(target)×tolerance。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="760" y="150" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6-skip" value="&lt;b&gt;gate 不通过&lt;/b&gt;&lt;br&gt;run-state paper-writing=skipped；dashboard.status=completed；不创建 paper worker。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="175" width="560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-auto" value="config.auto_write=true？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p6-1">
          <mxGeometry x="850" y="375" width="700" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-skip2" value="&lt;b&gt;AUTO_WRITE=false&lt;/b&gt;&lt;br&gt;paper-writing=skipped；dashboard.status=completed。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="390" width="560" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p6-input" value="&lt;b&gt;paper-writing worker 输入&lt;/b&gt;&lt;br&gt;summary/NARRATIVE_REPORT.md；ROOT/research-wiki/；最后一轮 final-inputs/EXPERIMENT_RESULTS.md；final-analysis/EXPERIMENT_RESULTS.md；dashboard.json。&lt;br&gt;context.metric_trajectory、final_metric、target_metric。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="585" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-plan" value="&lt;b&gt;子 skill：/paper-plan&lt;/b&gt;&lt;br&gt;从 narrative 抽取 claims/evidence/figures；生成 Claims-Evidence Matrix、章节结构、图表位置、citation scaffold；输出 PAPER_PLAN.md。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="780" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-fig" value="&lt;b&gt;子 skill：/paper-figure + illustration 分支&lt;/b&gt;&lt;br&gt;/paper-figure 读 PAPER_PLAN，生成 matplotlib/seaborn 图、LaTeX 表、figures/latex_includes.tex；architecture 可选 figurespec / paper-illustration / mermaid / codex-image2，写 figures/*。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="780" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-write" value="&lt;b&gt;子 skill：/paper-write&lt;/b&gt;&lt;br&gt;按 plan 写 section LaTeX；插入图表；构建 references.bib；清理 stale sections、未引用 bib、AI 风格词；输出 paper/main.tex、sections/*.tex、references.bib、math_commands.tex。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="1960" y="780" width="590" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-compile" value="&lt;b&gt;子 skill：/paper-compile&lt;/b&gt;&lt;br&gt;latexmk -pdf，多轮修复常见编译错误；检查 undefined refs、页数、字体嵌入、pdftotext；输出 paper/main.pdf。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1010" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-improve" value="&lt;b&gt;子 skill：/auto-paper-improvement-loop&lt;/b&gt;&lt;br&gt;最多 MAX_IMPROVEMENT_ROUNDS=2：review → fix → recompile；保留 round0/round1/round2 PDF 与 PAPER_IMPROVEMENT_LOG.md。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1170" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-audit" value="&lt;b&gt;submission assurance 审计&lt;/b&gt;&lt;br&gt;按内容检测调用 /proof-checker、/paper-claim-audit、/citation-audit；理论/范围论文可调用 /kill-argument。每个审计写对应 .json/.md；audit verifier 检查 artifact 存在、schema、hash 新鲜度、blocking verdict。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1330" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-audit-d" value="verify_paper_audits.sh exit=0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p6-1">
          <mxGeometry x="900" y="1525" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-fail" value="&lt;b&gt;阻断&lt;/b&gt;&lt;br&gt;submission assurance 下不能 accept paper-writing 或声称 submission-ready；按 MISSING / STALE / BLOCKING_VERDICT / SCHEMA_INVALID 修复并重跑审计。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="1515" width="560" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-out" value="&lt;b&gt;成功落盘&lt;/b&gt;&lt;br&gt;workers/paper-writing/outputs/paper/：main.pdf、LaTeX 源码、图、审计 JSON/MD、audit-verifier-report.json。&lt;br&gt;receipt.dashboard_patch：paper_status=compiled、audit_passed=true；run-state paper-writing done → accept(verdict=deterministic:verify_paper_audits.sh)；dashboard.status=completed。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1710" width="1220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-end" value="&lt;b&gt;运行完成&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p6-1">
          <mxGeometry x="930" y="1910" width="660" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-start" target="p6-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-gate" target="p6-skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-gate" target="p6-auto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-auto" target="p6-skip2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-auto" target="p6-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e6" value="AUTO_WRITE=false / gate false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-skip" target="p6-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-skip2" target="p6-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-input" target="p6-plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-plan" target="p6-fig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-fig" target="p6-write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-write" target="p6-compile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-compile" target="p6-improve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-improve" target="p6-audit">
