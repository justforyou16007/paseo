  <diagram id="phase0" name="01 Phase 0 初始化与恢复">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="p0-start" value="&lt;b&gt;进入 Phase 0&lt;/b&gt;&lt;br&gt;fresh 或 --resume &lt;run_id&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p0-1">
          <mxGeometry x="930" y="20" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p0-read" value="&lt;b&gt;解析项目和运行配置&lt;/b&gt;&lt;br&gt;动作：定位 ROOT；解析 project slug；解析 --max-iterations、--baseline、--auto-write、--render-html；用 tools/render_w_agent_prompt.sh --emit-config 生成一次 Paseo 配置。&lt;br&gt;落盘：.aris/runs/&lt;run_id&gt;.paseo-config.json，字段 executor_provider、executor_mode、executor_thinking、notify_on_finish。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="130" width="1080" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-metric" value="&lt;b&gt;读取并验证 Metric Target&lt;/b&gt;&lt;br&gt;子程序：metric-gate.js config ROOT。&lt;br&gt;输入：CLAUDE.md 中未被 HTML 注释的 ## Metric Target；字段 primary: 数值 + 单位、direction、tolerance、baseline。&lt;br&gt;输出：target、name、direction、tolerance、baseline。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="300" width="1080" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-md" value="Metric Target 可用且字段合法？&lt;br&gt;primary 是有限数；direction ∈ higher_better/lower_better；tolerance ∈ [0,1)。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="850" y="470" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p0-metric-fail" value="&lt;b&gt;失败&lt;/b&gt;&lt;br&gt;没有 active Metric Target 或字段非法；不创建可运行 loop。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="495" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-env" value="&lt;b&gt;检查生成的实验环境&lt;/b&gt;&lt;br&gt;输入：.claude/skills/run-&lt;project&gt;-experiment/env.json 与 scripts/。判断字段：env.json.status == complete 且 scripts/ 目录存在。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="660" width="1080" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-d" value="环境已完成？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p0-1">
          <mxGeometry x="900" y="815" width="580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-call" value="&lt;b&gt;子 skill：/experiment-env-manager&lt;/b&gt;&lt;br&gt;动作：以 mode=setup、run-id、paseo-config 调用；等待完成通知；读取 .aris/runs/&lt;run_id&gt;.experiment-env-manager.&lt;project&gt;.done.json；归档子 agent。&lt;br&gt;它负责生成 env.json/scripts 并完成环境审计。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="1780" y="790" width="570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-ok" value="env.json.status=complete 且 scripts/ 存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="1780" y="1010" width="570" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p0-env-fail" value="&lt;b&gt;失败&lt;/b&gt;&lt;br&gt;环境管理器完成但 bundle 仍无效；停止初始化。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="1780" y="1190" width="570" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-plan" value="&lt;b&gt;检查 baseline plan&lt;/b&gt;&lt;br&gt;输入路径：--baseline 或默认 refine-logs/EXPERIMENT_PLAN.md。判断：文件存在。&lt;br&gt;后续 Phase 1 iteration 1 直接使用此 MD；iteration 2+ 改用 gap-planner 输出的 plan。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1000" width="1080" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p0-plan-d" value="baseline EXPERIMENT_PLAN.md 存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p0-1">
          <mxGeometry x="850" y="1165" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p0-plan-fail" value="&lt;b&gt;失败&lt;/b&gt;&lt;br&gt;没有基线实验计划，不能进入迭代。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="1190" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p0-freshresume" value="&lt;b&gt;fresh / resume 分支&lt;/b&gt;&lt;br&gt;fresh：生成 run_id，创建 workers/，初始化 dashboard 和 run-state。&lt;br&gt;resume：读取 .aris/runs/&lt;run_id&gt;.json + dashboard.json；按 outer phase 与 current_phase 决定重跑、继续或跳过。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1360" width="1080" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p0-dashboard" value="&lt;b&gt;fresh 的初始化写入&lt;/b&gt;&lt;br&gt;.aris/runs/&lt;run_id&gt;/dashboard.json：run_id、project、status=running、iteration=1、max_iterations、current_phase=init；config.baseline_plan/auto_write/render_html/patience；metric.name/target/direction/tolerance/baseline/current=null/history=[]；best_idea=null；gaps.open/closed/total；last_review.verdict/score/reviewer_id；stop_reason=null；system_errors.total/last；applied_receipts=[]。&lt;br&gt;.aris/runs/&lt;run_id&gt;.json：phases=[init,loop,summary,paper-writing]，每项 status/artifact/verdict_id/reviewer/updated。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1550" width="1080" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p0-done" value="&lt;b&gt;初始化完成&lt;/b&gt;&lt;br&gt;run-state：init done → accept，verdict_id/reviewer=deterministic:preconditions；loop=running。&lt;br&gt;dashboard.current_phase=experiment-bridge；进入 Phase 1。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p0-1">
          <mxGeometry x="650" y="1750" width="1080" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p0-s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-start" target="p0-read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-read" target="p0-metric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-metric" target="p0-md">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-md" target="p0-metric-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-md" target="p0-env">
          <mxGeometry relative="1" as="geometry" />
