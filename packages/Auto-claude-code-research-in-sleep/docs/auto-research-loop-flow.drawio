        <mxCell id="p0-s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-env" target="p0-env-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s7" value="否，调用 setup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-env-d" target="p0-env-call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s8" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-env-d" target="p0-plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-env-call" target="p0-env-ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s10" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-env-ok" target="p0-env-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s11" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-env-ok" target="p0-plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-plan" target="p0-plan-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s13" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-plan-d" target="p0-plan-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s14" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p0-1" source="p0-plan-d" target="p0-freshresume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-freshresume" target="p0-dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-s16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p0-1" source="p0-dashboard" target="p0-done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0-source" value="源码依据：skills/auto-research-loop/SKILL.md §Phase 0、Fresh start vs Resume；src/tools/metric-gate.ts；src/tools/run-state.ts。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="1750" width="520" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase1" name="02 Phase 1 Experiment Bridge">
    <mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="p1-0" />
        <mxCell id="p1-1" parent="p1-0" />
        <mxCell id="p1-start" value="&lt;b&gt;Phase 1 开始&lt;/b&gt;&lt;br&gt;当前 iteration：ITERATION；目标指标：target_metric / target_unit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p1-1">
          <mxGeometry x="960" y="20" width="600" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-in" value="&lt;b&gt;输入清单&lt;/b&gt;&lt;br&gt;iteration 1：ROOT/BASELINE_PLAN；不传 idea_report。&lt;br&gt;iteration 2+：$WORKERS_DIR/&lt;ITERATION&gt;-gap-planner/outputs/EXPERIMENT_PLAN.md + $WORKERS_DIR/&lt;ITERATION&gt;-idea-discovery/outputs/IDEA_REPORT.md。&lt;br&gt;两种情况都传 experiment_skill：.claude/skills/run-&lt;project&gt;-experiment/env.json；context.is_baseline、target_metric、target_unit。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="135" width="1220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p1-manifest" value="&lt;b&gt;写 worker manifest&lt;/b&gt;&lt;br&gt;文件：.aris/runs/&lt;run_id&gt;/workers/&lt;ITERATION&gt;-experiment-bridge/input-manifest.json。&lt;br&gt;字段：worker=experiment-bridge、iteration、run_id、inputs.experiment_plan/idea_report?/experiment_skill、context.is_baseline/target_metric/target_unit、output_dir=.../outputs。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="320" width="1220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p1-dispatch" value="&lt;b&gt;子 skill：/experiment-bridge&lt;/b&gt;&lt;br&gt;调用：mcp__paseo__create_agent；prompt 只给 skill 名 + manifest 路径；provider/mode/thinking 从 run 的 Paseo config；等待通知后读 receipt.json、merge、archive。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="480" width="1220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p1-parse" value="&lt;b&gt;1. 解析 EXPERIMENT_PLAN.md&lt;/b&gt;&lt;br&gt;读出 run order、dataset/split/task、systems/variants、metrics、backbone/hyperparameters/seeds、success criterion、MUST-RUN/NICE-TO-HAVE、GPU 预算、method。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="635" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-code" value="&lt;b&gt;2. 实现实验代码&lt;/b&gt;&lt;br&gt;动作：先找并复用现有代码；补训练/评估/data loader/baseline；所有超参 argparse 可配置；固定 seed；结果写 JSON/CSV；按 sanity → baseline → main → ablation 实现。&lt;br&gt;改动：项目实验脚本、配置、日志代码；输入 MD 的每个命令/超参必须能在实现中找到对应字段。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="780" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p1-review-d" value="CODE_REVIEW=true？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p1-1">
          <mxGeometry x="930" y="960" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-review" value="&lt;b&gt;子 skill/agent：Codex code review&lt;/b&gt;&lt;br&gt;读取计划、FINAL_PROPOSAL、实现脚本；检查方法对应关系、超参、loss/data split/eval、真实 ground-truth、OOM/数值稳定/seed。&lt;br&gt;判断：CRITICAL=0 才继续；有 critical → 修复后最多重审 2 轮；create_agent 失败才允许跳过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="1960" y="935" width="590" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p1-sanity" value="&lt;b&gt;3. SANITY_FIRST：调用 /run-experiment&lt;/b&gt;&lt;br&gt;先运行最小 sanity 实验；不能在 bridge 进程内 inline 跑。&lt;br&gt;若 generated skill scripts/ 不存在，先调用 /experiment-env-manager mode=setup；等待 receipt。&lt;br&gt;验证：训练无错误、指标保存、GPU 内存、输出格式。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="1150" width="1220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p1-sanity-d" value="sanity 成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p1-1">
          <mxGeometry x="930" y="1335" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-debug" value="&lt;b&gt;失败调试&lt;/b&gt;&lt;br&gt;最多 3 次：按 stderr/traceback 分类 OOM、ImportError、路径、CUDA、NaN；修复后重跑；第 2 次起可调用 /codex:rescue；3 次仍失败 → 写 .aris/env-config/&lt;project&gt;/error-reports/&lt;timestamp&gt;.json 并调用 /experiment-env-manager mode=error-report。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="1300" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p1-route" value="&lt;b&gt;4. 按 job 数量路由部署&lt;/b&gt;&lt;br&gt;每个 milestone 依据 plan 的 jobs、multi-seed、phase dependency 判断。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="1525" width="1220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-route-d" value="≤5 jobs 且无大规模依赖？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p1-1">
          <mxGeometry x="930" y="1645" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-run" value="&lt;b&gt;子 skill：/run-experiment&lt;/b&gt;&lt;br&gt;调用 generated scripts：info.sh → prepare.sh（同步代码）→ run.sh；返回 handle；monitor.sh 验证启动；完成后 collect.sh 获取结果；Vast 配置 auto_destroy=true 时 teardown.sh。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="1810" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p1-queue" value="&lt;b&gt;子 skill：/experiment-queue&lt;/b&gt;&lt;br&gt;条件：≥10 jobs、multi-seed sweep、teacher→student 依赖或需 wave/OOM 管理。&lt;br&gt;写 experiment-queue/&lt;timestamp&gt;/manifest.json、run_meta.txt；远端持续写 .aris_queue/runs/&lt;timestamp&gt;/queue_state.json；按 expected output 判断完成。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="1960" y="1810" width="590" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1-monitor" value="&lt;b&gt;子 skill：/monitor-experiment&lt;/b&gt;&lt;br&gt;读取 monitor.sh JSON：status、gpu_usage、tail、exit_code、elapsed_seconds、wandb；必要时 collect.sh 下载 ./results/*.json 与 ./logs/*。&lt;br&gt;若仍 running：等待外部通知后再监控，不 busy-poll。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="1800" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-collect" value="&lt;b&gt;5. 收集并更新 tracker&lt;/b&gt;&lt;br&gt;输入：JSON/CSV/log、EXPERIMENT_PLAN.md success criteria。&lt;br&gt;改动：EXPERIMENT_TRACKER.md 的 Status/Notes；写初始 EXPERIMENT_RESULTS.md，记录每个 milestone、主指标、完成数、positive/negative/inconclusive、是否 ready。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="1985" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p1-analyze" value="&lt;b&gt;5.6 强制子 skill：/analyze-results&lt;/b&gt;&lt;br&gt;写 internal/analyze-results/input-manifest.json：results、tracker、experiment_plan、experiment_skill、error_report?、metric_history、output_dir=outputs/analysis。只允许分析本 worker 的结果/Tracker；不能换成项目根 results/logs。&lt;br&gt;验证 receipt：status=done、run/iteration 匹配、analysis/EXPERIMENT_RESULTS.md 存在、metric.current 有限。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="2160" width="1220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p1-analyze-fail" value="分析失败或 verifier 要补充？&lt;br&gt;失败是 experiment-bridge failed；不能退回 raw rows，也不能自动替用户接受 verifier 的 FAIL。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="910" y="2360" width="700" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1-ablation-d" value="主结果 positive？且需要消融？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="930" y="2550" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-ablation" value="&lt;b&gt;可选子 skill：/ablation-planner&lt;/b&gt;&lt;br&gt;读取主结果、method、claims、硬件；设计 component/hyperparameter/design-choice ablation；把新的 blocks 追加到 refine-logs/EXPERIMENT_PLAN.md 与 EXPERIMENT_TRACKER.md。主结果 negative/inconclusive 时跳过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="1960" y="2520" width="590" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1-out" value="&lt;b&gt;Phase 1 worker 输出&lt;/b&gt;&lt;br&gt;outputs/EXPERIMENT_RESULTS.md（原始汇总）&lt;br&gt;outputs/EXPERIMENT_TRACKER.md（执行状态）&lt;br&gt;outputs/analysis/EXPERIMENT_RESULTS.md（结构化分析）&lt;br&gt;receipt.json：metric.current、metric.delta、statistical_significance、experiment_ids；iteration 1 另有 metric.baseline；experiments[] 每项 slug/title/idea/verdict/confidence/metrics/reasoning/provenance/tags。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="2720" width="1220" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p1-merge" value="&lt;b&gt;主 orchestrator 合并&lt;/b&gt;&lt;br&gt;dashboard-merge.js apply：校验 receipt/input-manifest/iteration/current_phase/允许 patch；原子更新 dashboard.json；更新 metric.history（同 iteration 的 final analyze 会替换 bridge 的初值，不新增重复行）；追加 applied_receipts；若 has_errors 则累加 system_errors。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="2910" width="1220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p1-wiki" value="&lt;b&gt;主 orchestrator 的 canonical wiki 写入&lt;/b&gt;&lt;br&gt;逐条读取 receipt.experiments；调用 research-wiki.js add_experiment research-wiki/。写入实验实体字段：slug、title、idea、verdict、confidence、metrics、reasoning、provenance、tags。主 orchestrator 不读 worker 的 raw MD。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p1-1">
          <mxGeometry x="650" y="3080" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p1-end" value="&lt;b&gt;进入 Phase 2&lt;/b&gt;&lt;br&gt;current_phase=auto-review-loop" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p1-1">
          <mxGeometry x="950" y="3240" width="620" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-start" target="p1-in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-in" target="p1-manifest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-manifest" target="p1-dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-dispatch" target="p1-parse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-parse" target="p1-code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-code" target="p1-review-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-review-d" target="p1-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e8" value="否 / spawn 失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-review-d" target="p1-sanity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e9" value="无 CRITICAL 或修复后通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-review" target="p1-sanity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-sanity" target="p1-sanity-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e11" value="否，重试/调试" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-sanity-d" target="p1-debug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e12" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-sanity-d" target="p1-route">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e13" value="修复后再跑 sanity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-debug" target="p1-sanity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-route" target="p1-route-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e15" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-route-d" target="p1-run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e16" value="否：大批量/依赖" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-route-d" target="p1-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-run" target="p1-monitor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-queue" target="p1-monitor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-monitor" target="p1-collect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-collect" target="p1-analyze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-analyze" target="p1-analyze-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e22" value="是：worker failed / 等用户选择" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-analyze-fail" target="p1-debug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e23" value="否：analysis done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-analyze-fail" target="p1-ablation-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e24" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-ablation-d" target="p1-ablation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e25" value="否 / 不可用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-ablation-d" target="p1-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e26" value="追加计划后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p1-1" source="p1-ablation" target="p1-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-out" target="p1-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-merge" target="p1-wiki">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p1-1" source="p1-wiki" target="p1-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-source" value="源码依据：skills/auto-research-loop/SKILL.md §Phase 1；skills/experiment-bridge/SKILL.md §Phase 1–6；skills/analyze-results/SKILL.md §Manifest/Phase 1–5。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="3240" width="760" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase2" name="03 Phase 2 Auto Review Loop">
    <mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-start" value="&lt;b&gt;Phase 2 输入&lt;/b&gt;&lt;br&gt;本轮 experiment-bridge 的 analysis/EXPERIMENT_RESULTS.md、EXPERIMENT_TRACKER.md、原始 EXPERIMENT_RESULTS.md；本轮 experiment_plan；env.json；iteration 2+ 的 IDEA_REPORT。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="20" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p2-manifest" value="&lt;b&gt;写 manifest 并派发 /auto-review-loop&lt;/b&gt;&lt;br&gt;文件：workers/&lt;ITERATION&gt;-auto-review-loop/input-manifest.json；context.target_metric、target_unit、metric_history、reviewer_model、reviewer_bias_guard=true、max_review_rounds=4；prompt 只含 skill + manifest path。输出目录：outputs/。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="195" width="1220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-init" value="&lt;b&gt;初始化 / 恢复&lt;/b&gt;&lt;br&gt;读取 outputs/REVIEW_STATE.json（若存在）；status=completed → fresh；24h 内 in_progress → 恢复 round、threadId、score、pending_experiments；读取 AUTO_REVIEW.md、项目 notes、结果。&lt;br&gt;创建/更新 review-stage/AUTO_REVIEW.md（worker 模式映射到 outputs/AUTO_REVIEW.md）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="355" width="1220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-review" value="&lt;b&gt;Phase A：外部 reviewer&lt;/b&gt;&lt;br&gt;默认 Codex/gpt-5.5；Round 1 创建 fresh paseo codex agent，保存 agent-id 到 REVIEW_STATE.threadId；Round 2+ 用 send_agent_prompt 继续同一 reviewer。manual backend 使用 manual_review review/reply。&lt;br&gt;输入是文件路径：claims/paper、methods/code、raw results、changed files；reviewer 自己读文件。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="535" width="1220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2-assess" value="&lt;b&gt;Phase B：解析评估&lt;/b&gt;&lt;br&gt;保留 reviewer 的完整原文；提取 score（1–10）、verdict（ready / almost / not ready）、按严重度排序的 action items。&lt;br&gt;停止条件：score ≥ 6 且 verdict ∈ {ready, almost}；not ready 即使分数高也不能停。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="735" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2-stop-d" value="score ≥ 6 且 verdict=ready/almost？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="920" y="900" width="720" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-memory" value="&lt;b&gt;可选：hard/nightmare&lt;/b&gt;&lt;br&gt;写/追加 REVIEWER_MEMORY.md：每轮 suspicion、unresolved、patterns；Debate Protocol 中 executor rebuttal 最多 3 条，再让同一 reviewer 对每条给 SUSTAINED / OVERRULED / PARTIALLY SUSTAINED。medium 跳过。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="1960" y="875" width="590" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2-human" value="&lt;b&gt;可选 HUMAN_CHECKPOINT=true&lt;/b&gt;&lt;br&gt;把 score、弱点、建议修复交给用户；用户可 go、定制、skip 某项或 stop。默认 false，自动进入修复。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="1080" width="540" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2-fix" value="&lt;b&gt;Phase C：实现 action items&lt;/b&gt;&lt;br&gt;按优先级修复：实验脚本/模型代码/分析脚本；需要时用 generated run skill 的 prepare.sh + run.sh，不能手工绕过原子接口；补指标、结果表、项目 notes、review 文档。高成本/缺外部资源的项标记后续处理。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="1090" width="1220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p2-wait" value="&lt;b&gt;Phase D：等待与监控&lt;/b&gt;&lt;br&gt;如果启动实验：读取 monitor.sh/collect.sh；W&amp;B 可用且配置开启时派发 /training-check，检查 NaN、loss divergence、plateau、过拟合；未完成则等待外部事实，不在 loop 内忙轮询。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="1280" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2-doc" value="&lt;b&gt;Phase E：记录本轮&lt;/b&gt;&lt;br&gt;追加 AUTO_REVIEW.md：score/verdict/criticism、reviewer 完整原文、修复内容、结果、状态；更新 REVIEW_STATE.json：round、threadId、score、verdict、pending_experiments、status=in_progress；COMPACT=true 时追加 findings.md 一行。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="1450" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p2-loop" value="&lt;b&gt;继续审查&lt;/b&gt;&lt;br&gt;round += 1；回到 Phase A。MAX_ROUNDS=4；若达到上限仍 not ready，结束并列出 blocker/预计工作量/继续或 pivot 建议。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="1630" width="1220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2-term" value="&lt;b&gt;终止阶段&lt;/b&gt;&lt;br&gt;REVIEW_STATE.status=completed；AUTO_REVIEW.md 写最终总结和 ## Method Description；保留 review 轮次日志。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="1830" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2-final-inputs" value="&lt;b&gt;worker 模式的最终输入快照&lt;/b&gt;&lt;br&gt;复制最新结果到 outputs/final-inputs/EXPERIMENT_RESULTS.md 与 EXPERIMENT_TRACKER.md；未发生变化时复制 manifest 输入原文件。&lt;br&gt;禁止最终分析读项目根 results/logs/refine-logs 代替这些快照。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="1990" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2-final-analyze" value="&lt;b&gt;强制子 skill：最终 /analyze-results&lt;/b&gt;&lt;br&gt;写 internal/final-analyze/input-manifest.json：final-inputs、outer experiment_plan/experiment_skill、prior metric history、error_report?、output_dir=final-analysis。等待 receipt；要求 run/iteration 匹配、metric.current 有限；把 metric.current/delta/statistical_significance 原值复制到 auto-review receipt；失败即 worker failed。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="2160" width="1220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p2-claim" value="&lt;b&gt;可选子 skill：/result-to-claim&lt;/b&gt;&lt;br&gt;读取 AUTO_REVIEW.md 中的结果，把实验数字转成 CLAIMS_FROM_RESULTS.md；可写 .aris/claims.json 与 evidence_precheck.json；不可用时静默跳过。作用：给后续 /paper-plan 提供已验证 claim。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="1960" y="2140" width="590" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p2-html" value="&lt;b&gt;可选子 skill：/render-html&lt;/b&gt;&lt;br&gt;RENDER_HTML=true 时调用 /render-html AUTO_REVIEW.md --no-review --state REVIEW_STATE.json；输出 outputs/AUTO_REVIEW.html；HTML 失败只记录，不阻断 worker。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="1960" y="2320" width="590" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p2-out" value="&lt;b&gt;Phase 2 receipt.dashboard_patch&lt;/b&gt;&lt;br&gt;last_review.verdict、last_review.score、last_review.reviewer_id；metric.current、metric.delta、statistical_significance。&lt;br&gt;合并后：同 iteration 的 metric.history 条目由最终分析替换 bridge 初值；质量 verdict 保留在 last_review，不能作为 Phase 3 stop_reason。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="650" y="2375" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p2-end" value="&lt;b&gt;进入 Phase 3&lt;/b&gt;&lt;br&gt;读取 dashboard 字段做确定性指标判断" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p2-1">
          <mxGeometry x="950" y="2560" width="620" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-start" target="p2-manifest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-manifest" target="p2-init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-init" target="p2-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-review" target="p2-assess">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-assess" target="p2-stop-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-stop-d" target="p2-memory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e7" value="hard/nightmare 时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-memory" target="p2-human">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="medium 或记忆/辩论完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-memory" target="p2-fix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e9" value="checkpoint 开启" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-human" target="p2-fix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e10" value="checkpoint 关闭" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-memory" target="p2-fix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-fix" target="p2-wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-wait" target="p2-doc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e13" value="仍需修复 / round 未结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-doc" target="p2-loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-loop" target="p2-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e15" value="是，或 MAX_ROUNDS 到达" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-stop-d" target="p2-term">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-term" target="p2-final-inputs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-final-inputs" target="p2-final-analyze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e18" value="分析失败 → worker failed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-final-analyze" target="p2-final-inputs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e19" value="分析成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-final-analyze" target="p2-claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e20" value="可用时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-claim" target="p2-html">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e21" value="RENDER_HTML=true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-term" target="p2-html">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-html" target="p2-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e23" value="不可用也继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p2-1" source="p2-claim" target="p2-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p2-1" source="p2-out" target="p2-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-source" value="源码依据：skills/auto-review-loop/SKILL.md §Initialization、Phase A–E、Termination；skills/analyze-results/SKILL.md；skills/result-to-claim/SKILL.md；skills/render-html/SKILL.md。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="2560" width="760" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase3" name="04 Phase 3 Metric Evaluation">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />
        <mxCell id="p3-start" value="&lt;b&gt;Phase 3 开始&lt;/b&gt;&lt;br&gt;Phase 1/2 receipt 已合并；dashboard 是唯一输入。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p3-1">
          <mxGeometry x="850" y="20" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p3-input" value="&lt;b&gt;读取字段&lt;/b&gt;&lt;br&gt;.aris/runs/&lt;run_id&gt;/dashboard.json：metric.current、metric.target、metric.direction、metric.tolerance、metric.history；iteration、max_iterations；config.patience。&lt;br&gt;禁止：读取 worker Markdown、raw results、receipt 原文、last_review 做停止判断；禁止 dispatch/reviewer。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="145" width="1140" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-calc" value="&lt;b&gt;metric-gate.js evaluate&lt;/b&gt;&lt;br&gt;计算：band = abs(target) × tolerance；higher_better threshold = target − band；lower_better threshold = target + band。&lt;br&gt;patience：按 history.iter 排序，只有比此前 best 更好才清零，否则 streak+1；每次从 history 重算，不累积计数。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="330" width="1140" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-invalid" value="判断 1：current 非有限/为空，或 target、direction、tolerance、history、iteration、max_iterations、patience 非法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="525" width="920" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p3-invalid" value="&lt;b&gt;invalid_metric&lt;/b&gt;&lt;br&gt;metric-gate 原子写 dashboard.stop_reason=invalid_metric；dashboard.status=invalid；run-state：loop failed、summary skipped、paper-writing skipped；不生成 summary/paper。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="535" width="560" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-target" value="判断 2：目标达成？&lt;br&gt;higher_better：current ≥ target − abs(target)×tolerance；lower_better：current ≤ target + abs(target)×tolerance。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="735" width="920" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p3-target" value="stop_reason=metric_met&lt;br&gt;dashboard.status=finishing；run-state loop done；进入 Phase 5。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="1780" y="750" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-budget" value="判断 3：iteration ≥ max_iterations？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="945" width="920" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-budget" value="stop_reason=budget_exhausted&lt;br&gt;只说明预算耗尽，不说明质量；dashboard.status=finishing；loop done；进入 Phase 5。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="1780" y="960" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-d-patience" value="判断 4：trailing no-progress streak ≥ config.patience？默认 patience=2。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="740" y="1135" width="920" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p3-patience" value="stop_reason=patience_exhausted&lt;br&gt;只说明连续没有指标改善；dashboard.status=finishing；loop done；进入 Phase 5。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="1780" y="1150" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-continue" value="&lt;b&gt;没有任何停止原因&lt;/b&gt;&lt;br&gt;stop_reason 仍为 null；dashboard.status 继续 running。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="1340" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-inc" value="&lt;b&gt;进入下一 iteration&lt;/b&gt;&lt;br&gt;dashboard.iteration 只增加一次；current_phase=idea-discovery；source_iteration=旧 iteration。resume 若已在 idea-discovery，只从 iteration−1 推导 source_iteration，不能再次加一。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p3-1">
          <mxGeometry x="630" y="1480" width="1140" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p3-end" value="&lt;b&gt;进入 Phase 4&lt;/b&gt;&lt;br&gt;Idea Discovery 读取上一轮证据。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p3-1">
          <mxGeometry x="870" y="1645" width="660" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-start" target="p3-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-input" target="p3-calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-calc" target="p3-d-invalid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-invalid" target="p3-invalid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-invalid" target="p3-d-target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-target" target="p3-target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-target" target="p3-d-budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e8" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-budget" target="p3-budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-budget" target="p3-d-patience">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-patience" target="p3-patience">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e11" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p3-1" source="p3-d-patience" target="p3-continue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-continue" target="p3-inc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p3-1" source="p3-inc" target="p3-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-source" value="源码依据：skills/auto-research-loop/SKILL.md §Phase 3、Stop Gate；src/tools/metric-gate.ts evaluate。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p3-1">
