  </diagram>
  <diagram id="phase45" name="06 Phase 4.5 Gap Planner">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="p45-0" />
        <mxCell id="p45-1" parent="p45-0" />
        <mxCell id="p45-start" value="&lt;b&gt;Phase 4.5 开始&lt;/b&gt;&lt;br&gt;只在 Phase 4 选出 exactly one selected idea 后执行一次。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p45-1">
          <mxGeometry x="820" y="20" width="760" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p45-input" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;idea_report：本轮 IDEA_REPORT.md；上一轮 final-analysis/EXPERIMENT_RESULTS.md、final-inputs/EXPERIMENT_TRACKER.md、final-inputs/EXPERIMENT_RESULTS.md、AUTO_REVIEW.md；ROOT/research-wiki/gap_map.md。&lt;br&gt;context：source_iteration=iteration−1、metric_name/target/direction/tolerance/current/baseline/history、selected_idea_id。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="145" width="1220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p45-manifest" value="&lt;b&gt;写并派发 /gap-planner&lt;/b&gt;&lt;br&gt;manifest.worker 必须是 gap-planner；context.source_iteration = iteration−1；selected_idea_id 必须对应 IDEA_REPORT 的一个候选；output_dir=worker/outputs。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="350" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p45-audit" value="&lt;b&gt;1. 审计 gap_map&lt;/b&gt;&lt;br&gt;实验 analysis/tracker/results/review 是 gap 状态的证据；IDEA_REPORT 只在决定完成后用于把 provisional 描述/旧 id 映射到 canonical id。&lt;br&gt;动作：识别新 gap；重复项并入最老稳定 id；只有证据满足 closing condition 才 close；矛盾→refuted；低价值未解决→deferred；按 metric impact/evidence strength/cost 排序。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="510" width="1220" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p45-check" value="&lt;b&gt;结构检查&lt;/b&gt;&lt;br&gt;run/iteration/source_iteration/selected idea 一致；gap id 唯一；open/closed 不重叠；action 合法；每个 add/merge/close/refute 都有 evidence；selected idea 只映射 canonical open gap。失败直接 failed receipt，不替审计修正。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="40" y="510" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p45-json" value="&lt;b&gt;写 GAP_AUDIT.json&lt;/b&gt;&lt;br&gt;字段：schema_version、run_id、iteration、source_iteration、auditor=gap-planner；decisions[] {gap_id, action, merged_into, priority, evidence[], reason}；open_gap_ids、closed_gap_ids、total_gaps；selected_idea {id, canonical_gap_ids}。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="730" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p45-md" value="&lt;b&gt;同步写三份审计/规划 MD&lt;/b&gt;&lt;br&gt;outputs/gap_map.md：完整审计后的 gap map；outputs/GAP_ANALYSIS.md：带 evidence paths 的简要推理；outputs/EXPERIMENT_PLAN.md：下一轮自包含计划。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="920" width="1220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p45-plan" value="&lt;b&gt;2. 机械组装下一轮计划&lt;/b&gt;&lt;br&gt;读取 selected idea 的 exact candidate；不能换 idea；每个 canonical target gap 复制 priority/closing condition。只允许使用 candidate 已有的具体 code/config steps。每个 milestone 必含 gap_id、hypothesis、exact modification、command/config、dataset/split、seeds、metric、success threshold、expected artifact、dependency、runtime。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="1090" width="1220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p45-receipt" value="&lt;b&gt;receipt.dashboard_patch&lt;/b&gt;&lt;br&gt;gaps.open、gaps.closed、gaps.total、gap_audit_path、plan_path；primary_output=EXPERIMENT_PLAN.md；summary.operation=audit-and-plan、selected_idea_id、decisions、milestones。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="1290" width="1220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p45-merge" value="&lt;b&gt;主 orchestrator 合并与 root wiki 更新&lt;/b&gt;&lt;br&gt;dashboard-merge 原子更新 gap 字段；把 outputs/gap_map.md 复制为 ROOT/research-wiki/gap_map.md；调用 research-wiki rebuild_query_pack；current_phase=experiment-bridge；iteration 不再次改变。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p45-1">
          <mxGeometry x="590" y="1450" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p45-end" value="&lt;b&gt;进入下一轮 Phase 1&lt;/b&gt;&lt;br&gt;experiment-bridge 同时读取 gap-planner 的 EXPERIMENT_PLAN.md 与 idea-discovery 的 IDEA_REPORT.md" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p45-1">
          <mxGeometry x="790" y="1630" width="820" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p45-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-start" target="p45-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-input" target="p45-manifest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-manifest" target="p45-audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-audit" target="p45-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e5" value="结构失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p45-1" source="p45-check" target="p45-audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e6" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p45-1" source="p45-check" target="p45-json">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-json" target="p45-md">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-md" target="p45-plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-plan" target="p45-receipt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-receipt" target="p45-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p45-1" source="p45-merge" target="p45-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p45-source" value="源码依据：skills/auto-research-loop/SKILL.md §Phase 4.5；skills/gap-planner/SKILL.md 全文（Manifest、Audit、Compose、Receipt、Authority Boundary）。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p45-1">
          <mxGeometry x="40" y="1630" width="700" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase5" name="07 Phase 5 Summary">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="p5-0" />
        <mxCell id="p5-1" parent="p5-0" />
        <mxCell id="p5-start" value="&lt;b&gt;Phase 5 触发&lt;/b&gt;&lt;br&gt;dashboard.status=finishing；stop_reason 已由 metric-gate 确定。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="850" y="20" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p5-invalid" value="&lt;b&gt;例外：invalid_metric&lt;/b&gt;&lt;br&gt;Phase 5 被跳过；run-state loop=failed、summary=skipped、paper-writing=skipped；dashboard.status=invalid。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="150" width="540" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p5-input" value="&lt;b&gt;summary worker 输入&lt;/b&gt;&lt;br&gt;dashboard.json；research-wiki/index.md；research-wiki/gap_map.md；最后一轮 final-analysis/EXPERIMENT_RESULTS.md；最后一轮 AUTO_REVIEW.md。&lt;br&gt;context.stop_reason、total_iterations、final_metric、target_metric、metric_history。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="150" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p5-dispatch" value="&lt;b&gt;summary 子 agent&lt;/b&gt;&lt;br&gt;不是 /render-html；它负责从结构化输入生成新内容。调用 create_agent，要求只写 output_dir 指定路径。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="340" width="1220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5-report" value="&lt;b&gt;输出：NARRATIVE_REPORT.md&lt;/b&gt;&lt;br&gt;文件：workers/summary/outputs/NARRATIVE_REPORT.md。必须包含 metric_trajectory、stop_reason、iteration_log、open_gaps、closed_gaps、artifacts。receipt.primary_output=NARRATIVE_REPORT.md；dashboard_patch.summary_path=run-relative 路径。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="485" width="1220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p5-html-d" value="config.render_html=true？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="930" y="665" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-html" value="&lt;b&gt;可选子 skill：/render-html&lt;/b&gt;&lt;br&gt;输入：NARRATIVE_REPORT.md；选择 academic 模板，临时 HTML 仅结构转换；写 NARRATIVE_REPORT.html / receipt.html_rendered=true。失败记录但不阻断 summary。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="1960" y="635" width="590" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p5-accept" value="&lt;b&gt;run-state 写入&lt;/b&gt;&lt;br&gt;loop 用 deterministic:&lt;stop_reason&gt; accept，不能用 reviewer id；summary done → accept，verdict=deterministic:summary；artifact 指向 NARRATIVE_REPORT.md。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" vertex="1" parent="p5-1">
          <mxGeometry x="650" y="850" width="1220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p5-end" value="&lt;b&gt;进入 Phase 6&lt;/b&gt;&lt;br&gt;由 dashboard.metric、iteration、config.auto_write 决定是否写论文" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="850" y="1020" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p5-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-start" target="p5-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-input" target="p5-dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-dispatch" target="p5-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-report" target="p5-html-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p5-1" source="p5-html-d" target="p5-html">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e6" value="否 / 失败也继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p5-1" source="p5-html-d" target="p5-accept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-html" target="p5-accept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p5-1" source="p5-accept" target="p5-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-source" value="源码依据：skills/auto-research-loop/SKILL.md §Phase 5；skills/render-html/SKILL.md §Manifest/Workflow。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="1020" width="700" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phase6" name="08 Phase 6 Paper Writing">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="p6-0" />
        <mxCell id="p6-1" parent="p6-0" />
        <mxCell id="p6-start" value="&lt;b&gt;Phase 6 gate&lt;/b&gt;&lt;br&gt;输入：dashboard.metric.current、target、direction、tolerance、iteration、config.auto_write。" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p6-1">
          <mxGeometry x="850" y="20" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-gate" value="metric 达标 AND iteration ≥ 2？&lt;br&gt;higher_better：current ≥ target − abs(target)×tolerance；lower_better：current ≤ target + abs(target)×tolerance。" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="760" y="150" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6-skip" value="&lt;b&gt;gate 不通过&lt;/b&gt;&lt;br&gt;run-state paper-writing=skipped；dashboard.status=completed；不创建 paper worker。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="175" width="560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-auto" value="config.auto_write=true？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p6-1">
          <mxGeometry x="850" y="375" width="700" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-skip2" value="&lt;b&gt;AUTO_WRITE=false&lt;/b&gt;&lt;br&gt;paper-writing=skipped；dashboard.status=completed。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="390" width="560" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p6-input" value="&lt;b&gt;paper-writing worker 输入&lt;/b&gt;&lt;br&gt;summary/NARRATIVE_REPORT.md；ROOT/research-wiki/；最后一轮 final-inputs/EXPERIMENT_RESULTS.md；final-analysis/EXPERIMENT_RESULTS.md；dashboard.json。&lt;br&gt;context.metric_trajectory、final_metric、target_metric。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="585" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-plan" value="&lt;b&gt;子 skill：/paper-plan&lt;/b&gt;&lt;br&gt;从 narrative 抽取 claims/evidence/figures；生成 Claims-Evidence Matrix、章节结构、图表位置、citation scaffold；输出 PAPER_PLAN.md。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="780" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-fig" value="&lt;b&gt;子 skill：/paper-figure + illustration 分支&lt;/b&gt;&lt;br&gt;/paper-figure 读 PAPER_PLAN，生成 matplotlib/seaborn 图、LaTeX 表、figures/latex_includes.tex；architecture 可选 figurespec / paper-illustration / mermaid / codex-image2，写 figures/*。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="780" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-write" value="&lt;b&gt;子 skill：/paper-write&lt;/b&gt;&lt;br&gt;按 plan 写 section LaTeX；插入图表；构建 references.bib；清理 stale sections、未引用 bib、AI 风格词；输出 paper/main.tex、sections/*.tex、references.bib、math_commands.tex。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="1960" y="780" width="590" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-compile" value="&lt;b&gt;子 skill：/paper-compile&lt;/b&gt;&lt;br&gt;latexmk -pdf，多轮修复常见编译错误；检查 undefined refs、页数、字体嵌入、pdftotext；输出 paper/main.pdf。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1010" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-improve" value="&lt;b&gt;子 skill：/auto-paper-improvement-loop&lt;/b&gt;&lt;br&gt;最多 MAX_IMPROVEMENT_ROUNDS=2：review → fix → recompile；保留 round0/round1/round2 PDF 与 PAPER_IMPROVEMENT_LOG.md。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1170" width="1220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-audit" value="&lt;b&gt;submission assurance 审计&lt;/b&gt;&lt;br&gt;按内容检测调用 /proof-checker、/paper-claim-audit、/citation-audit；理论/范围论文可调用 /kill-argument。每个审计写对应 .json/.md；audit verifier 检查 artifact 存在、schema、hash 新鲜度、blocking verdict。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1330" width="1220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-audit-d" value="verify_paper_audits.sh exit=0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p6-1">
          <mxGeometry x="900" y="1525" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p6-fail" value="&lt;b&gt;阻断&lt;/b&gt;&lt;br&gt;submission assurance 下不能 accept paper-writing 或声称 submission-ready；按 MISSING / STALE / BLOCKING_VERDICT / SCHEMA_INVALID 修复并重跑审计。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="1515" width="560" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-out" value="&lt;b&gt;成功落盘&lt;/b&gt;&lt;br&gt;workers/paper-writing/outputs/paper/：main.pdf、LaTeX 源码、图、审计 JSON/MD、audit-verifier-report.json。&lt;br&gt;receipt.dashboard_patch：paper_status=compiled、audit_passed=true；run-state paper-writing done → accept(verdict=deterministic:verify_paper_audits.sh)；dashboard.status=completed。" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="650" y="1710" width="1220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-end" value="&lt;b&gt;运行完成&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="p6-1">
          <mxGeometry x="930" y="1910" width="660" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="p6-1" source="p6-start" target="p6-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-gate" target="p6-skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-gate" target="p6-auto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12;" edge="1" parent="p6-1" source="p6-auto" target="p6-skip2">
