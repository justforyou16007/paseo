<mxfile host="Electron" pages="12">
  <diagram id="overview" name="00 总流程">
    <mxGraphModel dx="2885" dy="1124" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="ov-0" />
        <mxCell id="ov-1" parent="ov-0" />
        <mxCell id="ov-start" parent="ov-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="&lt;b&gt;开始 / 恢复&lt;/b&gt;&lt;br&gt;参数：run_id、baseline plan、auto_write、render_html、max_iterations" vertex="1">
          <mxGeometry height="70" width="520" x="760" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ov-p0" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;Phase 0：前置条件与初始化&lt;/b&gt;&lt;br&gt;读取 CLAUDE.md 的 active Metric Target；确认实验环境 env.json.status=complete、scripts/ 存在、baseline EXPERIMENT_PLAN.md 存在；创建 dashboard.json 与 run-state.json。" vertex="1">
          <mxGeometry height="105" width="800" x="620" y="130" as="geometry" />
        </mxCell>
        <mxCell id="ov-p1" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;Phase 1：Experiment Bridge&lt;/b&gt;&lt;br&gt;实现计划中的实验、先做 sanity、部署并收集结果；内部强制调用 /analyze-results；receipt 发布 metric.current 等字段。" vertex="1">
          <mxGeometry height="100" width="800" x="620" y="285" as="geometry" />
        </mxCell>
        <mxCell id="ov-p2" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;Phase 2：Auto Review Loop&lt;/b&gt;&lt;br&gt;外部 reviewer 评分 → 代码/实验/分析修复 → 重新审查；结束时强制最终 /analyze-results，发布质量 verdict 和最终 metric。" vertex="1">
          <mxGeometry height="100" width="800" x="620" y="435" as="geometry" />
        </mxCell>
        <mxCell id="ov-p3" parent="ov-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=5;" value="&lt;b&gt;Phase 3：metric-gate.js&lt;/b&gt;&lt;br&gt;dashboard 字段 → invalid / target / budget / patience&lt;br&gt;写 stop_reason" vertex="1">
          <mxGeometry height="150" width="540" x="750" y="590" as="geometry" />
        </mxCell>
        <mxCell id="ov-stop" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=8;" value="&lt;b&gt;停止&lt;/b&gt;&lt;br&gt;metric_met / budget_exhausted / patience_exhausted&lt;br&gt;dashboard.status=finishing；loop done；进入 Phase 5" vertex="1">
          <mxGeometry height="100" width="500" x="1440" y="600" as="geometry" />
        </mxCell>
        <mxCell id="ov-invalid" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=8;" value="&lt;b&gt;无效指标&lt;/b&gt;&lt;br&gt;invalid_metric：loop failed；summary/paper-writing skipped；dashboard.status=invalid；退出" vertex="1">
          <mxGeometry height="100" width="500" x="30" y="600" as="geometry" />
        </mxCell>
        <mxCell id="ov-p4" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" value="&lt;b&gt;Phase 4：受约束 Idea Discovery&lt;/b&gt;&lt;br&gt;只读上一轮 final-analysis / results / tracker / AUTO_REVIEW 和 prior gap_map；禁止文献、web、pilot、开放式计划；生成 3–5 个候选并只选一个。" vertex="1">
          <mxGeometry height="110" width="800" x="620" y="820" as="geometry" />
        </mxCell>
        <mxCell id="ov-p45" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" value="&lt;b&gt;Phase 4.5：Gap Planner&lt;/b&gt;&lt;br&gt;唯一的缺口审计者；按实验证据合并/关闭/反驳/延期/排序 gap，并把已选 idea + canonical open gaps 组装成下一轮 EXPERIMENT_PLAN.md。" vertex="1">
          <mxGeometry height="110" width="800" x="620" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="ov-p5" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=8;" value="&lt;b&gt;Phase 5：Summary&lt;/b&gt;&lt;br&gt;summary 子 agent 读取 dashboard + wiki + 最后一轮分析/审查，生成 NARRATIVE_REPORT.md；可选调用 /render-html。" vertex="1">
          <mxGeometry height="100" width="500" x="1440" y="820" as="geometry" />
        </mxCell>
        <mxCell id="ov-p6" parent="ov-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;" value="&lt;b&gt;Phase 6：Paper Writing&lt;/b&gt;&lt;br&gt;达标且 iteration≥2；AUTO_WRITE=true；paper audit pass 后完成。" vertex="1">
          <mxGeometry height="110" width="500" x="2010" y="980" as="geometry" />
        </mxCell>
        <mxCell id="ov-end" parent="ov-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;dashboard.status=completed；run-state 四个外层 phase terminal" vertex="1">
          <mxGeometry height="70" width="500" x="1440" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="ov-e1" edge="1" parent="ov-1" source="ov-start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" target="ov-p0" value="">
