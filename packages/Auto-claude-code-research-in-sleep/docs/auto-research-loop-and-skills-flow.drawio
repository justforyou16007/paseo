  <diagram id="loop-stages" name="03 Auto Research Loop 子 skills">
    <mxGraphModel dx="1900" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1600" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="loop-0" />
        <mxCell id="loop-1" parent="loop-0" />
        <mxCell id="loop-title" value="&lt;b&gt;Auto Research Loop：三个阶段与嵌套子 skills&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2937;" vertex="1" parent="loop-1">
          <mxGeometry x="40" y="20" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="loop-subtitle" value="每轮均为 Stage 1 → Stage 2 → Stage 3 → gate；/analyze-results 在阶段内部运行，不是独立外层 phase。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="loop-1">
          <mxGeometry x="40" y="60" width="1820" height="30" as="geometry" />
        </mxCell>
        <mxCell id="loop-s1-box" value="&lt;b&gt;Stage 1：/idea-discovery（与 /research-pipeline Stage 1 同一契约）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#6c8ebf;strokeWidth=2;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="loop-1">
          <mxGeometry x="40" y="110" width="1820" height="300" as="geometry" />
        </mxCell>
        <mxCell id="loop-s1-input" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;RESEARCH_BRIEF + query_pack&lt;br&gt;iter≥2 另读上一轮证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=7;" vertex="1" parent="loop-s1-box">
          <mxGeometry x="20" y="85" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s1-lit" value="&lt;b&gt;/research-lit&lt;/b&gt;&lt;br&gt;文献调查与问题景观" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="loop-s1-box">
          <mxGeometry x="320" y="85" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s1-idea" value="&lt;b&gt;/idea-creator&lt;/b&gt;&lt;br&gt;生成候选 idea；Phase 7 upsert_idea 写 idea 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="loop-s1-box">
          <mxGeometry x="620" y="85" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s1-novelty" value="&lt;b&gt;/novelty-check&lt;/b&gt;&lt;br&gt;对高排名 idea 做深度新颖性核验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="loop-s1-box">
          <mxGeometry x="920" y="85" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s1-review" value="&lt;b&gt;/research-review&lt;/b&gt;&lt;br&gt;外部批评与跨模型评审" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="loop-s1-box">
          <mxGeometry x="1220" y="85" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s1-refine" value="&lt;b&gt;/research-refine-pipeline&lt;/b&gt;&lt;br&gt;细化方法；生成 FINAL_PROPOSAL.md + EXPERIMENT_PLAN.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=7;" vertex="1" parent="loop-s1-box">
          <mxGeometry x="1520" y="85" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s2-box" value="&lt;b&gt;Stage 2：/experiment-bridge（Workflow 1.5）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d79b00;strokeWidth=2;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="loop-1">
          <mxGeometry x="40" y="450" width="1820" height="300" as="geometry" />
        </mxCell>
        <mxCell id="loop-s2-input" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;IDEA_REPORT + EXPERIMENT_PLAN + env.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=7;" vertex="1" parent="loop-s2-box">
          <mxGeometry x="20" y="85" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s2-impl" value="&lt;b&gt;实现代码&lt;/b&gt;&lt;br&gt;按计划落地模型、数据与实验脚本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="loop-s2-box">
          <mxGeometry x="360" y="85" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s2-review" value="&lt;b&gt;cross-model code review&lt;/b&gt;&lt;br&gt;Codex 评审；发现代码问题先修复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="loop-s2-box">
          <mxGeometry x="700" y="85" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s2-run" value="&lt;b&gt;sanity → deploy / collect&lt;/b&gt;&lt;br&gt;小实验先行；≤5 jobs 用 run-experiment，更多时进 experiment-queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=7;" vertex="1" parent="loop-s2-box">
          <mxGeometry x="1040" y="85" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s2-analysis" value="&lt;b&gt;/analyze-results&lt;/b&gt;&lt;br&gt;结构化比较、统计与 metric.current；结果进入 bridge receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=7;" vertex="1" parent="loop-s2-box">
          <mxGeometry x="1380" y="85" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s3-box" value="&lt;b&gt;Stage 3：/auto-review-loop（Workflow 2）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#9673a6;strokeWidth=2;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="loop-1">
          <mxGeometry x="40" y="790" width="1820" height="480" as="geometry" />
        </mxCell>
        <mxCell id="loop-s3-input" value="&lt;b&gt;输入快照&lt;/b&gt;&lt;br&gt;analysis + tracker + results + plan + env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=7;" vertex="1" parent="loop-s3-box">
          <mxGeometry x="20" y="100" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s3-review" value="&lt;b&gt;Phase A/B&lt;/b&gt;&lt;br&gt;fresh Codex reviewer 评分；提取 score、verdict、action items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=7;" vertex="1" parent="loop-s3-box">
          <mxGeometry x="320" y="100" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s3-fix" value="&lt;b&gt;Phase C/D/E&lt;/b&gt;&lt;br&gt;按优先级修复、等待监控、记录 raw review 与 REVIEW_STATE；再审查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=7;" vertex="1" parent="loop-s3-box">
          <mxGeometry x="640" y="100" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s3-gate" value="&lt;b&gt;本轮审查结束？&lt;/b&gt;&lt;br&gt;score ≥ 6 且 verdict=ready/almost，或 round=4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=5;" vertex="1" parent="loop-s3-box">
          <mxGeometry x="960" y="85" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="loop-s3-final-analysis" value="&lt;b&gt;强制 final /analyze-results&lt;/b&gt;&lt;br&gt;使用 final-inputs 快照；校验 metric.current 有限并复制进 receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=7;" vertex="1" parent="loop-s3-box">
          <mxGeometry x="1300" y="100" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-s3-claim" value="&lt;b&gt;强制 /result-to-claim&lt;/b&gt;&lt;br&gt;写实验节点、supports/invalidates、idea outcome、problem 与 query_pack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=7;" vertex="1" parent="loop-s3-box">
          <mxGeometry x="1600" y="100" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="loop-repair" value="&lt;b&gt;bridge-repair（条件分支）&lt;/b&gt;&lt;br&gt;Stage 2 failed 或 Stage 3 返回 insufficient 时，回到 /experiment-bridge；沿用冻结输入，不跳过阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=8;" vertex="1" parent="loop-1">
          <mxGeometry x="500" y="1320" width="900" height="95" as="geometry" />
        </mxCell>
        <mxCell id="loop-note" value="评审 verdict 只结束当前 iteration 的 review/fix rounds；整个研究 loop 只能由外层 metric-gate 的 target、budget、patience 或 invalid_metric 结束。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="loop-1">
          <mxGeometry x="40" y="1450" width="1820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="loop-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="loop-1" source="loop-s1-input" target="loop-s1-lit">
