        <mxCell id="loop-e5" value="FINAL_PROPOSAL + PLAN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;entryX=0;entryY=0.333333;entryDx=0;entryDy=0;" edge="1" parent="loop-1" source="loop-s1-review" target="loop-s1-refine">
