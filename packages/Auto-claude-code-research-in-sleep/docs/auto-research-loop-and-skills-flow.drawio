  <diagram id="state-wiki" name="04 Worker、状态与 research-wiki">
    <mxGraphModel dx="1800" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="state-0" />
        <mxCell id="state-1" parent="state-0" />
        <mxCell id="state-title" value="&lt;b&gt;数据、状态与责任边界&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2937;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="state-subtitle" value="主 orchestrator 负责调度与机械合并；worker 负责分析和产物；wiki 由各自唯一写者更新。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="60" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state-runtime" value="&lt;b&gt;Paseo worker dispatch contract&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#6c8ebf;strokeWidth=2;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="110" width="1080" height="500" as="geometry" />
        </mxCell>
        <mxCell id="state-manifest" value="&lt;b&gt;input-manifest.json&lt;/b&gt;&lt;br&gt;完整 inputs/context/output_dir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=7;" vertex="1" parent="state-runtime">
          <mxGeometry x="20" y="85" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-dispatch" value="&lt;b&gt;Paseo&lt;/b&gt;&lt;br&gt;create_agent&lt;br&gt;prompt 只带 skill + manifest path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="state-runtime">
          <mxGeometry x="190" y="85" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-worker" value="&lt;b&gt;worker skill&lt;/b&gt;&lt;br&gt;读 manifest；写 outputs/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="state-runtime">
          <mxGeometry x="360" y="85" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-receipt" value="&lt;b&gt;receipt.json&lt;/b&gt;&lt;br&gt;status + dashboard_patch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="state-runtime">
          <mxGeometry x="530" y="85" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-merge" value="&lt;b&gt;dashboard-merge.js&lt;/b&gt;&lt;br&gt;校验、原子、幂等合并" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=6;" vertex="1" parent="state-runtime">
          <mxGeometry x="700" y="85" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-archive" value="&lt;b&gt;archive child&lt;/b&gt;&lt;br&gt;处理 receipt 后归档子 agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;spacing=6;" vertex="1" parent="state-runtime">
          <mxGeometry x="870" y="85" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-boundary" value="&lt;b&gt;读取边界&lt;/b&gt;&lt;br&gt;orchestrator 只读 dashboard.json 与 receipt.json；不读 worker 的 Markdown、结果、日志，不直接写 dashboard 或 research-wiki。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=7;" vertex="1" parent="state-runtime">
          <mxGeometry x="40" y="260" width="940" height="120" as="geometry" />
        </mxCell>
        <mxCell id="state-dashboard" value="&lt;b&gt;dashboard.json&lt;/b&gt;&lt;br&gt;唯一的 gate 输入：metric、history、last_review、stop_reason、failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1240" y="150" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-gate" value="&lt;b&gt;metric-gate.js evaluate&lt;/b&gt;&lt;br&gt;target / direction / tolerance / budget / patience" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=5;" vertex="1" parent="state-1">
          <mxGeometry x="1320" y="325" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="state-runstate" value="&lt;b&gt;run-state.json&lt;/b&gt;&lt;br&gt;只存 init、loop、summary、paper-writing 四个外层生命周期 phase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1240" y="520" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-wiki" value="&lt;b&gt;research-wiki：跨迭代记忆&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#9673a6;strokeWidth=2;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="690" width="1080" height="480" as="geometry" />
        </mxCell>
        <mxCell id="state-wiki-idea" value="&lt;b&gt;/idea-creator&lt;/b&gt;&lt;br&gt;写 ideas；连 addresses；outcome 初始 pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=7;" vertex="1" parent="state-wiki">
          <mxGeometry x="30" y="80" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="state-wiki-result" value="&lt;b&gt;/result-to-claim&lt;/b&gt;&lt;br&gt;写 experiments、edges、idea outcome、problem、query_pack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=7;" vertex="1" parent="state-wiki">
          <mxGeometry x="380" y="80" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="state-wiki-claim" value="&lt;b&gt;/proof-checker&lt;/b&gt;&lt;br&gt;唯一创建 claim 节点；维护证明状态轴" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=7;" vertex="1" parent="state-wiki">
          <mxGeometry x="730" y="80" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="state-wiki-problem" value="&lt;b&gt;problem 写者&lt;/b&gt;&lt;br&gt;/research-setup、/result-to-claim、/kill-argument；不删除页面，只变更状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=7;" vertex="1" parent="state-wiki">
          <mxGeometry x="30" y="230" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="state-wiki-helper" value="&lt;b&gt;research-wiki.js&lt;/b&gt;&lt;br&gt;所有实体变更通过 helper；不从 raw Markdown 猜字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="state-wiki">
          <mxGeometry x="380" y="230" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="state-wiki-query" value="&lt;b&gt;rebuild_query_pack&lt;/b&gt;&lt;br&gt;Open Problems + Failed Ideas → 下一轮 /idea-creator 的搜索种子与禁做清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=7;" vertex="1" parent="state-wiki">
