  <diagram id="research-setup-env" name="02 research-setup 与环境管理">
    <mxGraphModel dx="1800" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="env-0" />
        <mxCell id="env-1" parent="env-0" />
        <mxCell id="env-title" value="&lt;b&gt;项目初始化与实验环境准备&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2937;" vertex="1" parent="env-1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="env-subtitle" value="左侧由 /research-setup 收集研究信息；右侧由 /experiment-env-manager 独占环境脚本生成、审计和修复。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="env-1">
          <mxGeometry x="40" y="60" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-lane" value="&lt;b&gt;/research-setup：交互式研究项目向导&lt;/b&gt;" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#f8fafc;strokeColor=#9673a6;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="env-1">
          <mxGeometry x="40" y="110" width="820" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-start" value="&lt;b&gt;Phase 0&lt;/b&gt;&lt;br&gt;pre-flight、恢复检测、读取已有 artifacts、判断 language 与 mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="60" width="740" height="75" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-qa1" value="&lt;b&gt;Phase 1–3&lt;/b&gt;&lt;br&gt;项目基本信息、研究背景、已有论文/实验/结果；prior work 可跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="165" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-qa2" value="&lt;b&gt;Phase 4–6&lt;/b&gt;&lt;br&gt;环境需求、early stop、研究目标与 metric、reference knowledge、Paseo executor/reviewer 配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="290" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-artifacts" value="&lt;b&gt;Phase 7&lt;/b&gt;&lt;br&gt;生成 CLAUDE.md、RESEARCH_BRIEF.md、research-wiki、.gitignore、.aris/setup-state.json；创建 root problem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="425" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-review" value="&lt;b&gt;Phase 7.4&lt;/b&gt;&lt;br&gt;configuration review checklist：确认或调整 quick-mode defaults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="560" width="740" height="80" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-dispatch" value="&lt;b&gt;Phase 7.5&lt;/b&gt;&lt;br&gt;通过 Paseo 派发 /experiment-env-manager；等待其配置与审计完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="670" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-baseline" value="&lt;b&gt;Phase 7.6&lt;/b&gt;&lt;br&gt;把 baseline 方法、代码位置、命令、期望 metric 写进 RESEARCH_BRIEF；不执行复现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="790" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="env-rs-end" value="&lt;b&gt;Phase 8&lt;/b&gt;&lt;br&gt;总结产物、提示下一步 /aris-setup 或 /auto-research-loop" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=8;" vertex="1" parent="env-rs-lane">
          <mxGeometry x="40" y="920" width="740" height="75" as="geometry" />
        </mxCell>
        <mxCell id="env-em-lane" value="&lt;b&gt;/experiment-env-manager：环境配置、审计与修复的唯一入口&lt;/b&gt;" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#f8fafc;strokeColor=#d79b00;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="env-1">
          <mxGeometry x="940" y="110" width="820" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="env-em-start" value="&lt;b&gt;入口&lt;/b&gt;&lt;br&gt;mode=setup / error-report / audit；调用者可为 /research-setup、/aris-setup、/auto-research-loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=8;" vertex="1" parent="env-em-lane">
          <mxGeometry x="40" y="60" width="740" height="85" as="geometry" />
        </mxCell>
        <mxCell id="env-em-prd" value="&lt;b&gt;收集需求&lt;/b&gt;&lt;br&gt;把路径、依赖、资源、运行命令、错误采集、结果采集、监控和 baseline 组织成 PRD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="env-em-lane">
          <mxGeometry x="40" y="180" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="env-em-config" value="&lt;b&gt;dispatch /experiment-env-configuration&lt;/b&gt;&lt;br&gt;生成 env.json 与 scripts；状态先为 pending_audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="env-em-lane">
          <mxGeometry x="40" y="310" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="env-em-audit" value="&lt;b&gt;dispatch /experiment-env-audit&lt;/b&gt;&lt;br&gt;fresh auditor 读取配置，返回带时间戳与 patch-id 的结构化 verdict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="env-em-lane">
          <mxGeometry x="40" y="435" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="env-em-decision" value="&lt;b&gt;audit verdict&lt;/b&gt;&lt;br&gt;PASS / WARN？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=5;" vertex="1" parent="env-em-lane">
          <mxGeometry x="250" y="560" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="env-em-final" value="&lt;b&gt;唯一 finalize 点&lt;/b&gt;&lt;br&gt;把 env.json.status 从 pending_audit 原子更新为 complete；写完成 receipt&lt;br&gt;产物：info / prepare / run / monitor / collect / teardown scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=8;" vertex="1" parent="env-em-lane">
          <mxGeometry x="40" y="735" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="env-em-repair" value="&lt;b&gt;FAIL&lt;/b&gt;&lt;br&gt;按 patch_targets 修复并重新配置、重新审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=8;" vertex="1" parent="env-em-lane">
          <mxGeometry x="40" y="895" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="env-em-human" value="&lt;b&gt;无法自动修复&lt;/b&gt;&lt;br&gt;询问 owner、force-deploy 或停止；不伪造 complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=8;" vertex="1" parent="env-em-lane">
          <mxGeometry x="430" y="895" width="350" height="90" as="geometry" />
