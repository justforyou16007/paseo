  <diagram id="setup-gates" name="01 /aris-setup 六项前置">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="set-0" />
        <mxCell id="set-1" parent="set-0" />
        <mxCell id="set-title" value="&lt;b&gt;/aris-setup：正式运行前置条件&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2937;" vertex="1" parent="set-1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="set-subtitle" value="Phase 0 读取 status；已经 ready 的阶段跳过；缺失阶段由对应 skill 或 helper 补齐。tester 不可被跳过。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="set-1">
          <mxGeometry x="40" y="60" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="set-start" value="&lt;b&gt;Phase 0：status / infer&lt;/b&gt;&lt;br&gt;读取证据、全局 setup state 与当前 run 状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=8;" vertex="1" parent="set-1">
          <mxGeometry x="620" y="120" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="set-g1" value="&lt;b&gt;1 project_basics&lt;/b&gt;&lt;br&gt;CLAUDE.md + RESEARCH_BRIEF.md + 非空 research-wiki&lt;br&gt;负责人：/research-setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=7;" vertex="1" parent="set-1">
          <mxGeometry x="40" y="300" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="set-g2" value="&lt;b&gt;2 metric_target&lt;/b&gt;&lt;br&gt;CLAUDE.md 的 active ## Metric Target 可解析&lt;br&gt;负责人：/research-setup 或模板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=7;" vertex="1" parent="set-1">
          <mxGeometry x="340" y="300" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="set-g3" value="&lt;b&gt;3 experiment_env&lt;/b&gt;&lt;br&gt;env.json.status=complete 且 scripts/ 存在&lt;br&gt;负责人：/experiment-env-manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=7;" vertex="1" parent="set-1">
          <mxGeometry x="640" y="300" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="set-g4" value="&lt;b&gt;4 tester_agent&lt;/b&gt;&lt;br&gt;有效的 .aris/tester-agent-config.json&lt;br&gt;负责人：/tester-setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=7;" vertex="1" parent="set-1">
          <mxGeometry x="940" y="300" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="set-g5" value="&lt;b&gt;5 search_guard&lt;/b&gt;&lt;br&gt;policy + hash-chained ledger 可验证&lt;br&gt;负责人：search-audit-cli" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=7;" vertex="1" parent="set-1">
          <mxGeometry x="1240" y="300" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="set-g6" value="&lt;b&gt;6 root_charter&lt;/b&gt;&lt;br&gt;run.json + charter.json&lt;br&gt;负责人：/aris-setup Phase 5 + workflow-tools-cli root-setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=7;" vertex="1" parent="set-1">
          <mxGeometry x="1540" y="300" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="set-note" value="&lt;b&gt;/aris-setup 的职责&lt;/b&gt;&lt;br&gt;只负责顺序、确认、路由。project-setup-cli.js 负责 status / infer / assemble；helper 负责各自的验证与写入。不能用本地默认值替代缺失的 owner 输入。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="set-1">
          <mxGeometry x="40" y="560" width="520" height="170" as="geometry" />
        </mxCell>
        <mxCell id="set-artifacts" value="&lt;b&gt;确认并装配&lt;/b&gt;&lt;br&gt;.aris/global-setup-state.json&lt;br&gt;.aris/root-setup-answers.json → root-setup-input.json&lt;br&gt;七项 setup item 齐全后才允许封存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="set-1">
          <mxGeometry x="640" y="560" width="520" height="170" as="geometry" />
        </mxCell>
        <mxCell id="set-remaining" value="&lt;b&gt;仍有 blocking？&lt;/b&gt;&lt;br&gt;询问 owner、补齐证据、重新运行 status&lt;br&gt;不合成部分 charter，不绕过 tester 或搜索闸门" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=5;" vertex="1" parent="set-1">
          <mxGeometry x="1240" y="560" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="set-ready" value="&lt;b&gt;six stages ready&lt;/b&gt;&lt;br&gt;root setup sealed；formal run 可以启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="set-1">
          <mxGeometry x="580" y="850" width="640" height="90" as="geometry" />
