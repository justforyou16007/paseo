        <mxCell id="loop-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="loop-1" source="loop-s1-idea" target="loop-s1-novelty">
