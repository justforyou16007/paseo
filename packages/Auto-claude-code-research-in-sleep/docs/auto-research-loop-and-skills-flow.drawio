  <diagram id="tester-workflow" name="05 tester 与 workflow task setup">
    <mxGraphModel dx="1800" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="test-0" />
        <mxCell id="test-1" parent="test-0" />
        <mxCell id="test-title" value="&lt;b&gt;独立 tester 与 workflow task setup&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2937;" vertex="1" parent="test-1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="test-subtitle" value="tester 的案例和细粒度评分留在远端；研究侧只收到签名公共回执与固定的粗粒度反馈。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="test-1">
          <mxGeometry x="40" y="60" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="test-tester-lane" value="&lt;b&gt;/tester-setup：远端 tester 部署与搜索闸门&lt;/b&gt;" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#f8fafc;strokeColor=#9673a6;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="test-1">
          <mxGeometry x="40" y="110" width="820" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="test-t1" value="&lt;b&gt;1 Probe&lt;/b&gt;&lt;br&gt;验证 ssh、远端 Paseo daemon 与 claude 可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="55" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="test-t2" value="&lt;b&gt;2 Prepare bundle&lt;/b&gt;&lt;br&gt;准备唯一要推送到远端的 tester 操作手册" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="190" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="test-t3" value="&lt;b&gt;3 Deploy&lt;/b&gt;&lt;br&gt;在远端创建目录、生成 Ed25519 key、启动 tester agent；仅取回 public key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="325" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="test-t4" value="&lt;b&gt;4 Declare&lt;/b&gt;&lt;br&gt;tester 自己研究 domain、选择或设计 protocol、返回 submission contract；不返回 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="470" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="test-t5" value="&lt;b&gt;5 Emit policy&lt;/b&gt;&lt;br&gt;把 contract 的 search_exclusions 编译为 search-policy.json；只公开计数与 digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="615" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="test-t6" value="&lt;b&gt;6 Install guard&lt;/b&gt;&lt;br&gt;安装 PreToolUse hook 与 hash-chained search-audit ledger；submit 之前必须验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="760" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="test-t7" value="&lt;b&gt;7 Cleanup&lt;/b&gt;&lt;br&gt;清除本次 deployment 创建的 staging；操作幂等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="905" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="test-t8" value="&lt;b&gt;8 Emit config + handoff&lt;/b&gt;&lt;br&gt;固定 tester_agent_config；交给 workflow-tools-cli root-setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=8;" vertex="1" parent="test-tester-lane">
          <mxGeometry x="40" y="1040" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="test-workflow-lane" value="&lt;b&gt;/aris-setup Phase 3-5：冻结一次正式 run 的比较契约&lt;/b&gt;" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#f8fafc;strokeColor=#6c8ebf;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="test-1">
          <mxGeometry x="940" y="110" width="820" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="test-w1" value="&lt;b&gt;收集 root setup items&lt;/b&gt;&lt;br&gt;tester、tester_agent、thresholds、exposure、limits、resource、baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="test-workflow-lane">
          <mxGeometry x="40" y="55" width="740" height="125" as="geometry" />
        </mxCell>
        <mxCell id="test-w2" value="&lt;b&gt;验证 model roles 与 judge separation&lt;/b&gt;&lt;br&gt;冻结 tester、cases/seeds、阈值、exposure、预算与资源清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="test-workflow-lane">
          <mxGeometry x="40" y="225" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="test-w3" value="&lt;b&gt;task-setup&lt;/b&gt;&lt;br&gt;保存 model_usage_policy、tester binding、setup_revision；不能单独创建 charter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="test-workflow-lane">
          <mxGeometry x="40" y="385" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="test-w4" value="&lt;b&gt;project-setup-cli assemble&lt;/b&gt;&lt;br&gt;把 owner 答案与可追溯的 inferred 值合成 root-setup-input.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=8;" vertex="1" parent="test-workflow-lane">
          <mxGeometry x="40" y="530" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="test-w5" value="&lt;b&gt;workflow-tools-cli root-setup / setupRootRun&lt;/b&gt;&lt;br&gt;唯一封存点：写 run.json + charter.json；冻结 W_0 baseline、资源与 owner limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=8;" vertex="1" parent="test-workflow-lane">
          <mxGeometry x="40" y="675" width="740" height="120" as="geometry" />
        </mxCell>
        <mxCell id="test-w6" value="&lt;b&gt;启动后的 tester submission&lt;/b&gt;&lt;br&gt;只提交 reference + candidate 与 contract 声明的字段；cases、answers、per-case scores 永不回到研究侧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="test-workflow-lane">
          <mxGeometry x="40" y="840" width="740" height="125" as="geometry" />
        </mxCell>
        <mxCell id="test-w7" value="&lt;b&gt;可公开回执&lt;/b&gt;&lt;br&gt;terminal status、signed public receipt、fixed coarse feedback 与声明 metric aggregates；tester receipt 不是 research evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="test-workflow-lane">
