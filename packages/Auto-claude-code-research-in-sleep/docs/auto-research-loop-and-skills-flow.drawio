<mxfile host="Electron" version="31.4.5" type="device" pages="6">
  <diagram id="overview" name="00 总览：设置到自动研究循环">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="ov-0" />
        <mxCell id="ov-1" parent="ov-0" />
        <mxCell id="ov-title" value="&lt;b&gt;ARIS 当前流程总览&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2937;" vertex="1" parent="ov-1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ov-subtitle" value="从项目初始化、正式运行前置条件，到 metric-target-driven 的 Auto Research Loop；图中路径按当前 skills/ 与 src/tools/ 整理。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="ov-1">
          <mxGeometry x="40" y="60" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-start" value="&lt;b&gt;开始 / 恢复&lt;/b&gt;&lt;br&gt;新项目、已有项目或 --resume" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="640" y="100" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ov-check" value="&lt;b&gt;项目基础齐全？&lt;/b&gt;&lt;br&gt;CLAUDE.md + RESEARCH_BRIEF.md + research-wiki" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=5;" vertex="1" parent="ov-1">
          <mxGeometry x="760" y="200" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ov-research-setup" value="&lt;b&gt;/research-setup&lt;/b&gt;&lt;br&gt;交互式问答，生成项目基础与 Baseline Reproduction 信息&lt;br&gt;输出：CLAUDE.md、RESEARCH_BRIEF.md、research-wiki、setup-state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="70" y="350" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ov-aris-setup" value="&lt;b&gt;/aris-setup&lt;/b&gt;&lt;br&gt;按顺序检查六项 formal-run 前置条件；只确认缺失值并路由到负责 skill/helper&lt;br&gt;输出：可验证的 setup 状态与 root setup 输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="650" y="350" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ov-ready" value="&lt;b&gt;正式运行就绪&lt;/b&gt;&lt;br&gt;Metric Target、实验环境、tester、搜索闸门、root charter 均可验证&lt;br&gt;→ 允许启动 /auto-research-loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="1230" y="350" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ov-loop" value="&lt;b&gt;Auto Research Loop：每轮迭代&lt;/b&gt;&lt;br&gt;dashboard 驱动；默认最多 5 轮；metric-gate 只读结构化 dashboard 字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;container=1;pointerEvents=0;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;" vertex="1" parent="ov-1">
          <mxGeometry x="40" y="550" width="1720" height="410" as="geometry" />
        </mxCell>
        <mxCell id="ov-s1" value="&lt;b&gt;Stage 1&lt;/b&gt;&lt;br&gt;/idea-discovery&lt;br&gt;research-lit → idea-creator → novelty-check → research-review → refine&lt;br&gt;读 brief + query_pack；输出 IDEA_REPORT + EXPERIMENT_PLAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="ov-loop">
          <mxGeometry x="40" y="90" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ov-s2" value="&lt;b&gt;Stage 2&lt;/b&gt;&lt;br&gt;/experiment-bridge&lt;br&gt;实现 → 代码评审 → sanity → deploy/collect → analyze-results&lt;br&gt;输出 metric.current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="ov-loop">
          <mxGeometry x="470" y="90" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ov-s3" value="&lt;b&gt;Stage 3&lt;/b&gt;&lt;br&gt;/auto-review-loop&lt;br&gt;外部 reviewer → 修复 → 再审查，最多 4 轮&lt;br&gt;final analyze-results → /result-to-claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="ov-loop">
          <mxGeometry x="900" y="90" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ov-gate" value="&lt;b&gt;metric-gate.js evaluate&lt;/b&gt;&lt;br&gt;只读 dashboard.metric + history&lt;br&gt;判断 target / budget / patience / invalid" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=5;" vertex="1" parent="ov-loop">
          <mxGeometry x="1340" y="85" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ov-fail" value="&lt;b&gt;失败 / 无效&lt;/b&gt;&lt;br&gt;invalid_metric 或 worker failed&lt;br&gt;保留 dashboard.failure，停止后续派发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="520" y="1010" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ov-summary" value="&lt;b&gt;Summary&lt;/b&gt;&lt;br&gt;summary worker 读取 dashboard + wiki + 最后一轮证据&lt;br&gt;生成 NARRATIVE_REPORT.md；可选 /render-html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="930" y="1010" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ov-paper" value="&lt;b&gt;Paper Writing（可选）&lt;/b&gt;&lt;br&gt;AUTO_WRITE=true 且达标；paper audit verifier 通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="1390" y="1010" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ov-done" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;dashboard.status=completed；run-state 外层阶段完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="ov-1">
          <mxGeometry x="1000" y="1160" width="420" height="70" as="geometry" />
