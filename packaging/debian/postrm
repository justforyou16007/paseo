#!/bin/sh
set -e

case "$1" in
  remove)
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    ;;
  purge)
    # Daemon state and any agent credentials under /var/lib/paseo are user data;
    # purge is the only path that removes them.
    rm -rf /etc/paseo /var/lib/paseo
    if getent passwd paseo >/dev/null; then
      deluser --system paseo >/dev/null 2>&1 || true
    fi
    if getent group paseo >/dev/null; then
      delgroup --system paseo >/dev/null 2>&1 || true
    fi
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    ;;
esac

exit 0
