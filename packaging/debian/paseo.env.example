# Paseo daemon configuration.
#
# This file is read by the systemd unit as an EnvironmentFile: plain KEY=VALUE
# lines, no shell quoting, no variable expansion.

# Address the daemon listens on.
#   127.0.0.1:6767  local only
#   0.0.0.0:6767    reachable from the network (requires PASEO_PASSWORD)
PASEO_LISTEN=0.0.0.0:6767

# Serve the bundled browser UI on the same port. Without this you get the
# API but no page to open.
PASEO_WEB_UI_ENABLED=true

# Control password. The daemon accepts unauthenticated control connections
# from anyone who can reach it when this is empty, so never blank it out
# while PASEO_LISTEN is not loopback.
PASEO_PASSWORD=@GENERATED_PASSWORD@

# Hostnames allowed in the HTTP Host header. IP addresses and localhost are
# always allowed; DNS names are not. Reaching the daemon by name without
# listing it here returns "403 Host not allowed".
#PASEO_HOSTNAMES=paseo.example.com,.lan

# Logging.
PASEO_LOG_LEVEL=info
