[Unit]
Description=Paseo daemon (current user)
Documentation=https://paseo.sh
After=network-online.target

[Service]
Type=simple
# Runs as your login user, so the daemon sees the same code and the same agent
# credentials (~/.claude, ~/.codex) you use from a terminal. This is the unit
# that matches running `npm run dev:server` by hand.
EnvironmentFile=-%h/.config/paseo/paseo.env
Environment=PASEO_WEB_UI_ENABLED=true
ExecStart=/usr/bin/node /usr/lib/paseo/lib/node_modules/@getpaseo/server/dist/scripts/supervisor-entrypoint.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
