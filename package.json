{
  "name": "auto-research-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Independent worker and validation research tasks for Claude and Codex",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:clean",
    "build:clean": "npm run clean && tsc -p tsconfig.json",
    "clean": "node tools/clean.mjs",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "tsx",
    "test:python": "python3 -m unittest",
    "pack:arl": "npm run build && node tools/pack-arl.mjs",
    "lint": "oxlint src tools distribution tests",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "lefthook": "2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
